# Copy to .env and set when deploying
# Use your live Cloudflare Workers URL until the custom domain is connected.
# PUBLIC_SITE_URL=https://thewellmedia.com
# PUBLIC_FORMSUBMIT_EMAIL=hello@thewellmediahouse.com

# Design Studio (server-only — set in Cloudflare / wrangler, never PUBLIC_*)
# 1. Create D1: npx wrangler d1 create well-media-design-studio
# 2. Put the real database_id into wrangler.jsonc
# 3. Apply migrations: npm run db:migrate:local
#    Remote: npx wrangler d1 migrations apply well-media-design-studio --remote
# 4. Local full stack: npm run dev:worker
# 5. Create R2 bucket before production:
#    npx wrangler r2 bucket create well-media-design-studio-assets
#
# Cloudflare Turnstile (browser site key may be PUBLIC_; secret is Worker-only)
# PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Also copy .dev.vars.example → .dev.vars and set TURNSTILE_SECRET_KEY for wrangler dev
# Production: set real keys in Cloudflare dashboard / wrangler secret put TURNSTILE_SECRET_KEY
# OpenAI (Worker secrets — never PUBLIC_*):
# OPENAI_API_KEY=
# OPENAI_TEXT_MODEL=gpt-4.1-mini
# OPENAI_IMAGE_MODEL=gpt-image-1-mini
# PayFast sandbox only for V1 (Worker secrets — never PUBLIC_* except PUBLIC_SITE_URL):
# PAYFAST_MODE=sandbox
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PUBLIC_SITE_URL=https://your-workers-subdomain.workers.dev
# DESIGN_STUDIO_NOTIFY_EMAIL=schalk@thewellmedia.com
# DESIGN_STUDIO_TEAM_TOKEN=
# Protect /design-your-website/internal and /api/design-studio/internal/* with Cloudflare Access.
