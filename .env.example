# Copy to .env and set when deploying
# PUBLIC_SITE_URL=https://yourdomain.com
# Well Media staging Pages builds: PUBLIC_SITE_ENV=preview (noindex). Omit or use production for live.
# PUBLIC_SITE_ENV=preview
# PUBLIC_FORMSUBMIT_EMAIL=hello@yourdomain.com
# PUBLIC_WEB3FORMS_KEY=your-web3forms-access-key

# Optional Shopify Storefront (headless shop — docs/SHOP.md)
# PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# PUBLIC_SHOPIFY_STOREFRONT_TOKEN=shpat_storefront_or_headless_token
# PUBLIC_SHOPIFY_API_VERSION=2025-01
