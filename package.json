{
  "name": "cineyou",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "start": "next start",
    "lint": "eslint",
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 $(find lib -name '*.test.ts' | sort)",
    "test:bundle": "tsx --test --test-concurrency=1 lib/hardening/bundle.test.ts",
    "ci": "npm run check && npm run lint && npm run db:verify && npm test && npm run build && CINEYOU_REQUIRE_BUNDLE=1 npm run test:bundle",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cineyou-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply cineyou-production --remote",
    "db:seed:local": "wrangler d1 execute cineyou-production --local --file=scripts/seed-plans.sql",
    "db:seed:remote": "wrangler d1 execute cineyou-production --remote --file=scripts/seed-plans.sql",
    "db:verify": "npx tsx scripts/verify-schema.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "preview:smoke": "tsx scripts/preview-smoke.ts",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --containers-rollout none",
    "cf:deploy": "wrangler deploy --containers-rollout none",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@cloudflare/containers": "^0.3.7",
    "@opennextjs/cloudflare": "^1.20.2",
    "@radix-ui/react-slot": "^1.3.3",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "wrangler": "^4.124.0"
  }
}
