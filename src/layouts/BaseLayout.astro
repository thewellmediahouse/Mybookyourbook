---
import SEO from '@/components/utility/SEO.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import MessagingBubble from '@/components/utility/MessagingBubble.astro';
import { brandStyleAttribute, getThemeClass } from '@/utils/branding';
import { siteConfig } from '@/config/site';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  pathname?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, pathname = Astro.url.pathname, ogImage, noindex } = Astro.props;
---

<!doctype html>
<html lang={siteConfig.language} class={getThemeClass()} style={brandStyleAttribute()}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <SEO title={title} description={description} pathname={pathname} ogImage={ogImage} noindex={noindex} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-button focus:bg-neutral-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MessagingBubble />
  </body>
</html>
