---
import SEO from '@/components/utility/SEO.astro';
import MetaPixel from '@/components/utility/MetaPixel.astro';
import GoogleTag from '@/components/utility/GoogleTag.astro';
import AnnouncementBar from '@/components/layout/AnnouncementBar.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import MessagingBubble from '@/components/utility/MessagingBubble.astro';
import SiteMotion from '@/components/utility/SiteMotion.astro';
import { brandStyleAttribute, getThemeClass } from '@/utils/branding';
import { pagesConfig } from '@/config/pages';
import { siteConfig } from '@/config/site';
import { isPreviewSite } from '@/utils/site-env';
import '@/styles/global.css';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import inter700 from '@fontsource/inter/files/inter-latin-700-normal.woff2?url';
import playfair700 from '@fontsource/playfair-display/files/playfair-display-latin-700-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  pathname?: string;
  /** Share-card title (~40–60 chars). Falls back to clipped `title`. */
  ogTitle?: string;
  /** Share-card description (~120–150 chars). Falls back to clipped `description`. */
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  ogType?: 'website' | 'product';
  productPrice?: { amount: string; currency: string };
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description,
  pathname = Astro.url.pathname,
  ogTitle,
  ogDescription,
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  ogImageType,
  ogType,
  productPrice,
  jsonLd,
  noindex,
} = Astro.props;
const motionEnabled = pagesConfig.motion?.enabled === true;
const effectiveNoindex = Boolean(noindex) || isPreviewSite();
---

<!doctype html>
<html lang={siteConfig.language} class={getThemeClass()}>
  <head>
    <meta charset="UTF-8" />
    <style is:inline set:html={`:root{${brandStyleAttribute()}}`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={playfair700} as="font" type="font/woff2" crossorigin />
    <SEO
      title={title}
      description={description}
      pathname={pathname}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      ogImageWidth={ogImageWidth}
      ogImageHeight={ogImageHeight}
      ogImageType={ogImageType}
      ogType={ogType}
      productPrice={productPrice}
      jsonLd={jsonLd}
      noindex={effectiveNoindex}
    />
    <MetaPixel />
    <GoogleTag />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-button focus:bg-neutral-900 focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to main content
    </a>
    <AnnouncementBar />
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MessagingBubble />
    {motionEnabled && <SiteMotion />}
  </body>
</html>
