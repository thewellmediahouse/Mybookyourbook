---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';

const title = 'Page not found';
const description = 'The page you are looking for does not exist.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="py-section">
    <div class="container max-w-xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent">404</p>
      <h1 class="mt-2 text-display font-bold text-fg">Page not found</h1>
      <p class="mt-4 text-fg-soft">
        The page you requested may have moved or no longer exists.
      </p>
      <div class="mt-8">
        <Button href="/" variant="accent" size="lg">
          Back to home
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
