---
/**
 * Post-purchase thank-you / conversion landing page.
 * Not included in site navigation.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import { seoConfig } from '@/config/seo';
import { THANK_YOU_PATH, thankYouConfig } from '@/config/thank-you';

const seo = seoConfig.pages.thankYou;
const copy = thankYouConfig;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
  pathname={THANK_YOU_PATH}
  noindex={true}
>
  <section class="py-section">
    <Container size="narrow">
      <div class="surface-card space-y-6 p-8 text-center sm:p-12">
        <p class="text-small font-semibold uppercase tracking-wide text-accent">{copy.eyebrow}</p>
        <h1 class="text-h1 font-semibold text-fg">{copy.heading}</h1>
        <p class="text-lg text-fg-muted">{copy.paragraph}</p>
        <p class="text-body text-fg-soft">{copy.supportingText}</p>

        <div class="flex flex-col items-center justify-center gap-3 pt-2 sm:flex-row sm:gap-4">
          <a
            href={copy.primaryCta.href}
            class="btn-accent inline-flex items-center justify-center rounded-button px-6 py-3 font-semibold"
          >
            {copy.primaryCta.label}
          </a>
          <a
            href={copy.secondaryCta.href}
            class="inline-flex items-center justify-center rounded-button border-2 border-accent px-6 py-3 font-medium text-fg-soft transition-colors hover:bg-accent/10 hover:text-fg"
          >
            {copy.secondaryCta.label}
          </a>
        </div>

        <p class="pt-2 text-small text-fg-subtle">
          Need help?
          <a
            href={copy.contactCta.href}
            class="font-medium text-accent underline underline-offset-2 hover:text-primary"
          >
            {copy.contactCta.label}
          </a>
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>
