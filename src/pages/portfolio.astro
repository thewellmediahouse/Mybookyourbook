---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PortfolioHero from '@/components/sections/PortfolioHero.astro';
import PortfolioGallery from '@/components/sections/PortfolioGallery.astro';
import StatsStrip from '@/components/sections/StatsStrip.astro';
import CTASection from '@/components/marketing/CTASection.astro';
import { contentConfig } from '@/config/content';
import { pagesConfig } from '@/config/pages';
import { portfolioConfig } from '@/config/portfolio';
import { seoConfig } from '@/config/seo';

const sections = pagesConfig.sections.portfolio;
const seo = seoConfig.pages.portfolio;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  pathname="/portfolio/"
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
>
  {sections.hero && <PortfolioHero {...contentConfig.portfolio.hero} />}

  {
    sections.portfolioGrid && (
      <PortfolioGallery
        categories={portfolioConfig.categories}
        items={portfolioConfig.items}
      />
    )
  }

  {sections.stats && <StatsStrip items={contentConfig.stats} />}

  {
    sections.cta && (
      <CTASection
        heading={contentConfig.portfolio.cta.heading}
        primaryCta={contentConfig.portfolio.cta.primaryCta}
        secondaryCta={contentConfig.portfolio.cta.secondaryCta}
        background="primary"
      />
    )
  }
</BaseLayout>
