---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/utility/PageHeader.astro';
import ServiceGrid from '@/components/marketing/ServiceGrid.astro';
import BundlePackages from '@/components/sections/BundlePackages.astro';
import AlaCartePricing from '@/components/sections/AlaCartePricing.astro';
import PricingTerminology from '@/components/sections/PricingTerminology.astro';
import CTASection from '@/components/marketing/CTASection.astro';
import { servicesConfig } from '@/config/services';
import { contentConfig } from '@/config/content';
import { pagesConfig } from '@/config/pages';
import { packagesConfig } from '@/config/packages';

import { seoConfig } from '@/config/seo';

const sections = pagesConfig.sections.services;
const seo = seoConfig.pages.services;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  pathname="/services/"
  ogTitle={seo.ogTitle}
  ogDescription={seo.ogDescription}
>
  {
    sections.pageHeader && (
      <PageHeader
        heading={contentConfig.services.pageHeader.title}
        subheading={contentConfig.services.pageHeader.intro}
      />
    )
  }

  {
    sections.serviceGrid && (
      <ServiceGrid
        heading="What we offer"
        services={servicesConfig}
        packageGroups={
          sections.packageOverview && packagesConfig.servicePackages.length > 0
            ? packagesConfig.servicePackages
            : undefined
        }
        showDetailsLink={false}
      />
    )
  }

  {
    sections.bundles && packagesConfig.bundles.length > 0 && (
      <BundlePackages
        heading={contentConfig.services.bundles.heading}
        subheading={contentConfig.services.bundles.subheading}
        bundles={packagesConfig.bundles}
      />
    )
  }

  {
    sections.alaCarte && packagesConfig.alaCarte.length > 0 && (
      <AlaCartePricing
        heading={contentConfig.services.alaCarte.heading}
        subheading={contentConfig.services.alaCarte.subheading}
        items={packagesConfig.alaCarte}
      />
    )
  }

  {
    sections.terminology && packagesConfig.terminology.length > 0 && (
      <PricingTerminology
        heading={contentConfig.services.terminology.heading}
        subheading={contentConfig.services.terminology.subheading}
        entries={packagesConfig.terminology}
      />
    )
  }

  {
    sections.cta && (
      <CTASection
        heading={contentConfig.services.cta.heading}
        primaryCta={contentConfig.services.cta.primaryCta}
        background="neutral"
      />
    )
  }
</BaseLayout>
