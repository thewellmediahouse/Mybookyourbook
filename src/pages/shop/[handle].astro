---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import AddToCartButton from '@/components/shop/AddToCartButton.astro';
import BuyButton from '@/components/shop/BuyButton.astro';
import ProductVariantPicker from '@/components/shop/ProductVariantPicker.astro';
import RelatedProducts from '@/components/shop/RelatedProducts.astro';
import LiveStockSync from '@/components/shop/LiveStockSync.astro';
import ShopifyImage from '@/components/shop/ShopifyImage.astro';
import { shopConfig } from '@/config/shop';
import { pagesConfig } from '@/config/pages';
import { siteConfig } from '@/config/site';
import { clipForShareCard, resolveCanonicalUrl } from '@/utils/seo';
import { getSiteUrl } from '@/utils/site-url';
import { safeHttpUrl } from '@/lib/html-safe';
import { buildProductOgCard } from '@/lib/og/product-card';
import { sanitizeProductHtml } from '@/lib/sanitize-product-html';
import {
  formatMoney,
  getAddonBreakdown,
  getProductByHandle,
  getProductHandles,
  getRelatedProducts,
  isShopifyConfigured,
  pickDefaultVariant,
} from '@/lib/shopify';

export async function getStaticPaths() {
  if (!pagesConfig.shop || !isShopifyConfigured()) return [];

  const handles = await getProductHandles();
  return handles.map((handle) => ({ params: { handle } }));
}

if (!pagesConfig.shop) {
  return Astro.redirect('/');
}

const { handle } = Astro.params;
const product = handle ? await getProductByHandle(handle) : null;

if (!product) {
  return Astro.redirect('/shop/');
}

const variants = product.variants.nodes;
const selectedVariant = pickDefaultVariant(variants);
const images = product.images.nodes.length
  ? product.images.nodes
  : product.featuredImage
    ? [product.featuredImage]
    : [];
const primaryImage = selectedVariant?.image
  ? {
      url: selectedVariant.image.url,
      altText: selectedVariant.image.altText,
      width: 1000,
      height: 1000,
    }
  : (images[0] ?? null);
const price = selectedVariant
  ? formatMoney(selectedVariant.price)
  : formatMoney(product.priceRange.minVariantPrice);
const offerPrice = selectedVariant?.price ?? product.priceRange.minVariantPrice;
const addonBreakdown = getAddonBreakdown(variants, selectedVariant);
const addonLabels = shopConfig.addonPricing?.breakdownLabels;
const safeDescriptionHtml = product.descriptionHtml
  ? sanitizeProductHtml(product.descriptionHtml)
  : '';
const labels = shopConfig.labels;
const availability = shopConfig.availability;
const productCopy = shopConfig.product;

const pageTitle = `${product.title} | ${siteConfig.name}`;
const pageDescription =
  product.description?.slice(0, 155) || `Buy ${product.title} from ${siteConfig.name}.`;
const shareTitle = clipForShareCard(product.title, 60);
const shareDescription = clipForShareCard(pageDescription, 150);
const pathname = `/shop/${product.handle}/`;
const siteUrl = getSiteUrl(Astro.site);
const canonicalUrl = resolveCanonicalUrl(siteUrl, pathname);

const ogCard = await buildProductOgCard({
  handle: product.handle,
  imageUrl: primaryImage?.url ?? product.featuredImage?.url,
});

const relatedProducts = await getRelatedProducts(product.id, { limit: 3 });

const productImageUrls = [
  ...new Set(
    [primaryImage?.url, product.featuredImage?.url, ...images.map((image) => image.url)]
      .map((url) => safeHttpUrl(url))
      .filter((url): url is string => Boolean(url)),
  ),
];

const productJsonLd = {
  '@type': 'Product',
  '@id': `${canonicalUrl}#product`,
  name: product.title,
  description: pageDescription,
  url: canonicalUrl,
  image: productImageUrls.length ? productImageUrls : undefined,
  sku: product.handle,
  brand: {
    '@type': 'Brand',
    name: siteConfig.name,
  },
  offers: {
    '@type': 'Offer',
    url: canonicalUrl,
    priceCurrency: offerPrice.currencyCode,
    price: offerPrice.amount,
    availability: product.availableForSale
      ? 'https://schema.org/InStock'
      : 'https://schema.org/OutOfStock',
    seller: {
      '@type': 'Organization',
      name: siteConfig.name,
    },
  },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  pathname={pathname}
  ogTitle={shareTitle}
  ogDescription={shareDescription}
  ogType="product"
  ogImage={ogCard?.src}
  ogImageAlt={ogCard ? (primaryImage?.altText ?? product.title) : undefined}
  ogImageWidth={ogCard?.width}
  ogImageHeight={ogCard?.height}
  ogImageType={ogCard?.type}
  productPrice={{ amount: offerPrice.amount, currency: offerPrice.currencyCode }}
  jsonLd={[productJsonLd]}
>
  <section class="py-section">
    <div class="container space-y-8">
      <a href="/shop/" class="text-small font-medium text-primary hover:underline">{labels.backToShop}</a>

      <div class="grid gap-10 lg:grid-cols-2" data-product-form data-product-handle={product.handle}>
        <div class="space-y-4">
          <div class="overflow-hidden rounded-card bg-black/20">
            {
              primaryImage ? (
                <ShopifyImage
                  productImage
                  url={primaryImage.url}
                  alt={primaryImage.altText ?? product.title}
                  class="aspect-square w-full object-cover"
                  width={primaryImage.width ?? 1000}
                  height={primaryImage.height ?? 1000}
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 1024px) 100vw, 50vw"
                  loading="eager"
                />
              ) : (
                <div class="flex aspect-square items-center justify-center text-fg-muted">
                  {labels.noImage}
                </div>
              )
            }
          </div>
          {
            images.length > 1 && (
              <div class="grid grid-cols-4 gap-3" data-product-gallery role="list">
                {images.slice(0, 4).map((image, index) => {
                  const isActive = primaryImage?.url === image.url;
                  return (
                    <button
                      type="button"
                      role="listitem"
                      data-gallery-thumb
                      data-image-url={image.url}
                      data-image-alt={image.altText ?? product.title}
                      aria-label={`View image ${index + 1} of ${Math.min(images.length, 4)}`}
                      aria-pressed={isActive ? 'true' : 'false'}
                      class:list={[
                        'overflow-hidden rounded-card focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40',
                        isActive ? 'ring-2 ring-primary' : 'ring-1 ring-transparent hover:ring-primary/30',
                      ]}
                    >
                      <ShopifyImage
                        url={image.url}
                        alt={image.altText ?? product.title}
                        class="aspect-square w-full object-cover"
                        width={image.width ?? 300}
                        height={image.height ?? 300}
                        widths={[160, 320]}
                        sizes="80px"
                        loading="lazy"
                      />
                    </button>
                  );
                })}
              </div>
            )
          }
        </div>

        <div class="space-y-6">
          <div class="space-y-3">
            <h1 class="text-h1 font-semibold text-fg">{product.title}</h1>
            <div class="space-y-2">
              <p
                class="space-y-0.5 text-small text-fg-muted"
                data-price-breakdown
                hidden={!addonBreakdown}
              >
                <span class="flex justify-between gap-4">
                  <span>{addonLabels?.unit ?? 'Unit'}</span>
                  <span data-breakdown-unit>
                    {addonBreakdown ? formatMoney(addonBreakdown.unit) : ''}
                  </span>
                </span>
                <span class="flex justify-between gap-4">
                  <span>{addonLabels?.addon ?? 'Add-on'}</span>
                  <span data-breakdown-addon>
                    {addonBreakdown ? formatMoney(addonBreakdown.addon) : ''}
                  </span>
                </span>
              </p>
              <p class="text-2xl font-bold text-primary" data-product-price>{price}</p>
            </div>
            <p
              class:list={[
                'text-small font-medium',
                selectedVariant?.availableForSale ? 'text-primary' : 'text-fg-muted',
              ]}
              data-product-availability
            >
              {
                selectedVariant?.availableForSale
                  ? availability.available
                  : availability.currentlyUnavailable
              }
            </p>
          </div>

          {
            safeDescriptionHtml ? (
              <div class="prose prose-sm max-w-none text-fg-muted" set:html={safeDescriptionHtml} />
            ) : product.description ? (
              <p class="text-fg-muted">{product.description}</p>
            ) : null
          }

          <ProductVariantPicker
            variants={variants}
            initialVariantId={selectedVariant?.id ?? ''}
          />

          <div class="space-y-3">
            <div class="flex flex-wrap gap-3">
              <AddToCartButton
                variantId={selectedVariant?.id ?? ''}
                available={Boolean(selectedVariant?.availableForSale)}
              />
              <BuyButton
                variantId={selectedVariant?.id ?? ''}
                available={Boolean(selectedVariant?.availableForSale)}
              />
            </div>
            {
              productCopy.secondaryCtas.length > 0 && (
                <div class="flex flex-wrap gap-3">
                  {productCopy.secondaryCtas.map((cta) => (
                    <Button variant="outline" href={cta.href} external={cta.external}>
                      {cta.label}
                    </Button>
                  ))}
                </div>
              )
            }
            <p class="text-xs text-fg-subtle">{productCopy.checkoutHint}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <RelatedProducts products={relatedProducts} />
  <LiveStockSync />
</BaseLayout>

<script>
  import { parseShopifyWidthsAttr, shopifyImageSrcset, shopifyImageUrl } from '@/lib/shopify/image-url';

  function applyProductImage(imageEl: HTMLImageElement, url: string) {
    const widths = parseShopifyWidthsAttr(imageEl.dataset.shopifyWidths);
    const fallback = widths[widths.length - 1] ?? 1000;
    imageEl.src = shopifyImageUrl(url, fallback);
    if (widths.length) imageEl.srcset = shopifyImageSrcset(url, widths);
  }

  function initProductGalleries() {
    document.querySelectorAll('[data-product-form]').forEach((form) => {
      if (!(form instanceof HTMLElement) || form.dataset.galleryBound === 'true') return;
      form.dataset.galleryBound = 'true';

      const imageEl = form.querySelector<HTMLImageElement>('[data-product-image]');
      const thumbs = [...form.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]')];
      if (!imageEl || thumbs.length === 0) return;

      const mainImage = imageEl;

      function setActiveThumb(url: string) {
        thumbs.forEach((thumb) => {
          const active = thumb.dataset.imageUrl === url;
          thumb.setAttribute('aria-pressed', active ? 'true' : 'false');
          thumb.classList.toggle('ring-2', active);
          thumb.classList.toggle('ring-primary', active);
          thumb.classList.toggle('ring-1', !active);
          thumb.classList.toggle('ring-transparent', !active);
        });
      }

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          const url = thumb.dataset.imageUrl;
          if (!url) return;
          applyProductImage(mainImage, url);
          mainImage.alt = thumb.dataset.imageAlt ?? mainImage.alt;
          setActiveThumb(url);
        });
      });

      form.addEventListener('shop:product-image-updated', ((event: CustomEvent<{ url: string }>) => {
        if (event.detail?.url) setActiveThumb(event.detail.url);
      }) as EventListener);
    });
  }

  initProductGalleries();
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-product-form]').forEach((form) => {
      if (form instanceof HTMLElement) delete form.dataset.galleryBound;
    });
    initProductGalleries();
  });
</script>
