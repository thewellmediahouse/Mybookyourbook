---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutHero from '@/components/sections/AboutHero.astro';
import AboutIntro from '@/components/sections/AboutIntro.astro';
import ServicesIconRow from '@/components/sections/ServicesIconRow.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import WhyChooseUs from '@/components/sections/WhyChooseUs.astro';
import PhasedImplementation from '@/components/sections/PhasedImplementation.astro';
import CTASection from '@/components/marketing/CTASection.astro';
import { contentConfig } from '@/config/content';
import { pagesConfig } from '@/config/pages';
import { seoConfig } from '@/config/seo';

const sections = pagesConfig.sections.about;
const why = contentConfig.whyChooseUs;
const seo = seoConfig.pages.about;
---

<BaseLayout title={seo.title} description={seo.description} pathname="/about">
  {sections.hero && <AboutHero {...contentConfig.about.hero} />}

  {
    sections.intro && (
      <AboutIntro
        heading={contentConfig.about.intro.heading}
        paragraph={contentConfig.about.intro.paragraph}
      />
    )
  }

  {sections.capabilities && <ServicesIconRow items={contentConfig.capabilities} />}

  {sections.process && <ProcessSteps steps={contentConfig.processSteps} />}

  {
    sections.whyChooseUs && (
      <WhyChooseUs
        heading={why.heading}
        paragraph={why.paragraph}
        bullets={why.bullets}
      />
    )
  }

  {
    sections.phasedImplementation && (
      <PhasedImplementation
        intro={contentConfig.phasedImplementation.intro}
        phases={contentConfig.phasedImplementation.phases}
      />
    )
  }

  {
    sections.cta && (
      <CTASection
        heading={contentConfig.about.cta.heading}
        primaryCta={contentConfig.about.cta.primaryCta}
        background="primary"
      />
    )
  }
</BaseLayout>
