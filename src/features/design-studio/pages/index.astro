---
import BaseLayout from '@/layouts/BaseLayout.astro';
import DesignStudioHero from '@/components/design-studio/DesignStudioHero.astro';
import Container from '@/components/ui/Container.astro';
import { designStudioConfig } from '@/config/designStudio';
import { seoConfig } from '@/config/seo';
import { designStudioNotFoundIfDisabled } from '@/utils/design-studio/featureGate';

const disabled = designStudioNotFoundIfDisabled();
if (disabled) return disabled;

const seo = seoConfig.pages.designYourWebsite;
const { landing } = designStudioConfig;
---

<BaseLayout title={seo.title} description={seo.description} pathname="/design-your-website">
  <DesignStudioHero />

  <section class="border-t border-[var(--brand-border-subtle)] py-section" aria-labelledby="how-it-works">
    <Container>
      <div class="mx-auto max-w-3xl text-center">
        <h2 id="how-it-works" class="font-display text-h2 text-fg">How it works</h2>
        <p class="mt-3 text-fg-soft">{designStudioConfig.branding.descriptor}</p>
      </div>

      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {
          landing.steps.map((step) => (
            <li class="surface-card p-6 text-center">
              <span class="inline-flex size-12 items-center justify-center rounded-full border border-accent/40 text-accent">
                {step.step}
              </span>
              <h3 class="mt-4 font-display text-h4 text-fg">{step.title}</h3>
              <p class="mt-2 text-small text-fg-muted">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </Container>
  </section>
</BaseLayout>
