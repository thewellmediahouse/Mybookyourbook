---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import { designStudioConfig } from '@/config/designStudio';
import { seoConfig } from '@/config/seo';
import { designStudioNotFoundIfDisabled } from '@/utils/design-studio/featureGate';

const disabled = designStudioNotFoundIfDisabled();
if (disabled) return disabled;

const seo = seoConfig.pages.designYourWebsitePaymentCancel;
const { branding, contactRoute } = designStudioConfig;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  pathname="/design-your-website/payment/cancel"
>
  <section class="py-section-sm">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-small font-medium tracking-[0.18em] text-accent uppercase">
          {branding.eyebrow}
        </p>
        <h1 class="mt-3 font-display text-h2 text-fg">Payment cancelled</h1>
        <p class="mt-4 text-fg-soft">
          No payment was taken. Your selected direction and contact details are still saved — you
          can return to checkout whenever you are ready.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <Button href={contactRoute} variant="accent" size="sm">Return to checkout</Button>
          <Button href="/design-your-website" variant="outline" size="sm">Design Studio home</Button>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
