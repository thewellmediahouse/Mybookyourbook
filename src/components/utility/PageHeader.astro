---
import HeroHeading from '@/components/ui/HeroHeading.astro';

interface Props {
  heading: string;
  headingHighlight?: string;
  subheading?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { heading, headingHighlight, subheading, align = 'left', class: className = '' } = Astro.props;
const alignClass = align === 'center' ? 'text-center' : 'text-left';
---

<section class={`section-hero border-b border-white/10 py-section-sm ${className}`}>
  <div class={`container ${alignClass}`}>
    <HeroHeading heading={heading} headingHighlight={headingHighlight} />
    {subheading && (
      <p class="mt-4 text-lg text-fg-soft">{subheading}</p>
    )}
  </div>
</section>
