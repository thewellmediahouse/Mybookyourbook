---
/**
 * Google tag (gtag.js) — GA4 on each full document load.
 * Injected from BaseLayout; skipped on preview / local development.
 */
import { analyticsConfig } from '@/config/analytics';
import { getSiteEnv } from '@/utils/site-env';

const measurementId = analyticsConfig.googleMeasurementId.trim();
const enabled = Boolean(measurementId) && getSiteEnv() === 'production';
---

{
  enabled && (
    <>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${measurementId}`}
      />
      <script is:inline define:vars={{ measurementId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', measurementId);
      </script>
    </>
  )
}
