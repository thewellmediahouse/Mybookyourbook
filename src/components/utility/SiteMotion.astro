---
/**
 * Optional site-wide scroll reveal + hover lift.
 * Progressive enhancement; respects prefers-reduced-motion.
 * Enable via `pagesConfig.motion.enabled`.
 */
---

<script>
  function initSiteMotion() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.add('site-motion');
    if (reduce) {
      document.documentElement.classList.add('site-motion--reduced');
      return;
    }

    const roots = Array.from(
      document.querySelectorAll<HTMLElement>(
        'main > section, main > div.flex, footer, [data-motion]',
      ),
    );

    roots.forEach((el, index) => {
      if (el.dataset.motionBound) return;
      el.dataset.motionBound = 'true';
      el.classList.add('motion-reveal');
      el.style.setProperty('--motion-delay', `${Math.min(index * 40, 200)}ms`);

      // Above-the-fold heroes stay visible immediately
      if (
        el.classList.contains('hero-fullbleed') ||
        el.classList.contains('section-hero') ||
        el.querySelector('.hero-fullbleed, .section-hero')
      ) {
        el.classList.add('is-visible');
      }
    });

    document.querySelectorAll<HTMLElement>('[data-motion-stagger]').forEach((group) => {
      Array.from(group.children).forEach((child, i) => {
        if (!(child instanceof HTMLElement)) return;
        child.classList.add('motion-reveal', 'motion-reveal--child');
        child.style.setProperty('--motion-delay', `${80 + i * 70}ms`);
      });
    });

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          (entry.target as HTMLElement).classList.add('is-visible');
          io.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
    );

    document.querySelectorAll<HTMLElement>('.motion-reveal:not(.is-visible)').forEach((el) => {
      io.observe(el);
    });
  }

  initSiteMotion();
  document.addEventListener('astro:page-load', initSiteMotion);
</script>
