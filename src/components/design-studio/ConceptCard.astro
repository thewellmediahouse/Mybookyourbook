---
import type { ConceptDirection } from '@/types/designStudio';

interface Props {
  concept: ConceptDirection;
  index: number;
  demoMode?: boolean;
}

const { concept, index, demoMode = true } = Astro.props;
const number = String(index + 1).padStart(2, '0');
---

<article class="surface-card flex h-full flex-col overflow-hidden p-0">
  <div
    class:list={[
      'relative aspect-[3/4] overflow-hidden bg-gradient-to-br',
      concept.mockAccent ?? 'from-[#061426] to-[#050A18]',
    ]}
    aria-hidden="true"
  >
    <div class="absolute inset-x-6 top-6 rounded-t-lg border border-white/10 bg-black/35 p-3 backdrop-blur-sm">
      <div class="mb-3 flex items-center gap-1.5">
        <span class="size-2 rounded-full bg-white/30"></span>
        <span class="size-2 rounded-full bg-white/30"></span>
        <span class="size-2 rounded-full bg-white/30"></span>
      </div>
      <div class="space-y-2">
        <div class="h-2 w-1/3 rounded bg-accent/70"></div>
        <div class="h-2 w-2/3 rounded bg-white/25"></div>
        <div class="mt-4 grid grid-cols-3 gap-2">
          <div class="aspect-video rounded bg-white/10"></div>
          <div class="aspect-video rounded bg-white/15"></div>
          <div class="aspect-video rounded bg-white/10"></div>
        </div>
      </div>
    </div>
    <p class="absolute right-4 bottom-4 rounded-full border border-white/15 bg-black/40 px-3 py-1 text-xs text-fg-muted">
      Concept preview
    </p>
  </div>

  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-xs tracking-[0.16em] text-accent uppercase">Concept {number}</p>
        <h3 class="mt-1 font-display text-h3 text-fg">{concept.name}</h3>
      </div>
      {
        concept.mockPalette && (
          <div class="flex gap-1.5" aria-label="Colour direction">
            {concept.mockPalette.map((colour) => (
              <span
                class="size-5 rounded-full border border-white/20"
                style={`background-color: ${colour}`}
                title={colour}
              />
            ))}
          </div>
        )
      }
    </div>

    <p class="mt-3 text-body text-fg-soft">{concept.oneLineConcept}</p>

    <ul class="mt-4 flex flex-wrap gap-2" role="list">
      {
        concept.targetFeeling.map((tag) => (
          <li class="rounded-full border border-[var(--brand-border-subtle)] px-3 py-1 text-xs text-fg-muted">
            {tag}
          </li>
        ))
      }
    </ul>

    {
      concept.bestFor && (
        <p class="mt-4 text-small text-fg-muted">
          <span class="text-fg-soft">Best for:</span> {concept.bestFor}
        </p>
      )
    }

    <p class="mt-3 text-small text-fg-muted">{concept.conversionStrategy}</p>

    <div class="mt-6 flex flex-wrap gap-2">
      <button
        type="button"
        class="inline-flex items-center justify-center rounded-button border-2 border-accent bg-transparent px-3 py-1.5 text-small font-medium text-fg-soft transition-colors hover:bg-accent/10 hover:text-fg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        data-concept-view={concept.id}
      >
        View Concept
      </button>
      <button
        type="button"
        class="btn-accent inline-flex items-center justify-center rounded-button px-3 py-1.5 text-small font-medium transition-colors hover:brightness-105 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary disabled:cursor-not-allowed disabled:opacity-50"
        data-concept-choose={concept.id}
        disabled={demoMode}
        title={demoMode ? 'Selection and checkout arrive in a later phase' : undefined}
      >
        Choose This Direction
      </button>
    </div>
  </div>
</article>
