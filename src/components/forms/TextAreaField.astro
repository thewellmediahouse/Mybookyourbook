---
interface Props {
  name: string;
  label: string;
  required?: boolean;
  placeholder?: string;
  rows?: number;
  id?: string;
}

const {
  name,
  label,
  required = false,
  placeholder,
  rows = 5,
  id = name,
} = Astro.props;
---

<div>
  <label for={id} class="block text-small text-fg-label">
    {label}
    {required && <span class="text-accent"> *</span>}
  </label>
  <textarea
    id={id}
    name={name}
    rows={rows}
    required={required}
    placeholder={placeholder}
    class="mt-1 block w-full rounded-textarea border px-4 py-2.5 text-fg shadow-sm focus:border-accent focus:ring-1 focus:ring-accent"
  ></textarea>
</div>
