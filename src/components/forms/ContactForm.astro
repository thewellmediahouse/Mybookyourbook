---
import { formConfig, resolveFormAction, type FormConfig } from '@/config/form';
import type { FormField as FormFieldConfig } from '@/config/form';
import FormFieldInput from '@/components/forms/FormField.astro';
import SelectField from '@/components/forms/SelectField.astro';
import TextAreaField from '@/components/forms/TextAreaField.astro';
import FileField from '@/components/forms/FileField.astro';

interface Props {
  class?: string;
  submitLabel?: string;
  submitNote?: string;
  config?: FormConfig;
  formId?: string;
}

const {
  class: className = '',
  submitLabel = 'Send message',
  submitNote,
  config = formConfig,
  formId = 'contact-form',
} = Astro.props;

function inputType(field: FormFieldConfig): 'text' | 'email' | 'tel' | 'date' {
  if (field.type === 'select' || field.type === 'textarea' || field.type === 'file') {
    return 'text';
  }
  return field.type;
}

type FieldBlock =
  | { kind: 'section'; title: string }
  | { kind: 'field'; field: FormFieldConfig }
  | { kind: 'row'; fields: FormFieldConfig[] };

/** Preserve field order; group consecutive half-width fields into rows. */
function buildBlocks(fields: FormFieldConfig[]): FieldBlock[] {
  const blocks: FieldBlock[] = [];
  let lastSection = '';
  let rowBuffer: FormFieldConfig[] = [];

  function flushRow() {
    if (rowBuffer.length === 1) {
      blocks.push({ kind: 'field', field: rowBuffer[0]! });
    } else if (rowBuffer.length > 1) {
      blocks.push({ kind: 'row', fields: [...rowBuffer] });
    }
    rowBuffer = [];
  }

  for (const field of fields) {
    if (field.section && field.section !== lastSection) {
      flushRow();
      lastSection = field.section;
      blocks.push({ kind: 'section', title: field.section });
    }

    if (field.halfWidth) {
      rowBuffer.push(field);
      if (rowBuffer.length >= 2) flushRow();
      continue;
    }

    flushRow();
    blocks.push({ kind: 'field', field });
  }

  flushRow();
  return blocks;
}

const action = resolveFormAction(config);
const blocks = buildBlocks(config.fields);
const hasFileField = config.fields.some((field) => field.type === 'file');
---

<form
  id={formId}
  action={action}
  method="POST"
  class={`space-y-6 ${className}`}
  data-contact-form
  data-provider={config.provider}
  data-success-message={config.successMessage}
  data-error-message={config.errorMessage}
  enctype={hasFileField ? 'multipart/form-data' : undefined}
>
  {
    config.provider === 'web3forms' && (
      <input type="hidden" name="access_key" value={config.endpoint} />
    )
  }
  {
    config.provider === 'formsubmit' && (
      <input type="hidden" name="_captcha" value="false" />
    )
  }
  {
    config.subject && (
      <input type="hidden" name="_subject" value={config.subject} />
    )
  }
  <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

  {
    blocks.map((block) => {
      if (block.kind === 'section') {
        return <h3 class="pt-2 text-h4 font-semibold text-fg">{block.title}</h3>;
      }

      const fields = block.kind === 'row' ? block.fields : [block.field];
      const inner = fields.map((field) => {
        if (field.type === 'select' && field.options) {
          return (
            <SelectField
              name={field.name}
              label={field.label}
              options={field.options}
              required={field.required}
              emptyOptionLabel={field.emptyOptionLabel}
            />
          );
        }
        if (field.type === 'textarea') {
          return (
            <TextAreaField
              name={field.name}
              label={field.label}
              required={field.required}
              placeholder={field.placeholder}
            />
          );
        }
        if (field.type === 'file') {
          return (
            <FileField
              name={field.name}
              label={field.label}
              required={field.required}
              hint={field.hint}
              accept={field.accept}
              maxSizeMb={field.maxSizeMb}
              multiple={field.multiple}
            />
          );
        }
        return (
          <FormFieldInput
            name={field.name}
            label={field.label}
            type={inputType(field)}
            required={field.required}
            placeholder={field.placeholder}
          />
        );
      });

      if (block.kind === 'row') {
        return <div class="grid gap-6 sm:grid-cols-2">{inner}</div>;
      }
      return inner;
    })
  }

  {
    submitNote && <p class="text-body text-fg-muted">{submitNote}</p>
  }

  <div>
    <button
      type="submit"
      class="btn-accent inline-flex items-center justify-center rounded-button px-6 py-3 font-semibold transition-all focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent disabled:opacity-60"
    >
      {submitLabel}
    </button>
    <p class="mt-3 text-xs text-fg-subtle" role="status" data-form-status hidden></p>
  </div>
</form>

<script>
  function bindContactForm(form: HTMLFormElement) {
    if (form.dataset.bound === 'true') return;
    form.dataset.bound = 'true';

    const status = form.querySelector<HTMLElement>('[data-form-status]');

    async function wasSubmissionSuccessful(
      response: Response,
      provider: string | undefined,
    ): Promise<{ ok: boolean; message?: string }> {
      const contentType = response.headers.get('content-type') ?? '';
      const isJson = contentType.includes('application/json');

      if (provider === 'formsubmit' && isJson) {
        const data = (await response.json()) as { success?: boolean | string; message?: string };
        const ok = data.success === true || data.success === 'true';
        return { ok, message: ok ? undefined : data.message };
      }

      if (provider === 'formspree' && isJson) {
        const data = (await response.json()) as { ok?: boolean };
        return { ok: data.ok === true };
      }

      return { ok: response.ok };
    }

    function validateFiles(): string | null {
      const inputs = form.querySelectorAll<HTMLInputElement>('input[type="file"]');
      for (const input of inputs) {
        const files = [...(input.files ?? [])];
        const maxMb = Number.parseFloat(input.dataset.maxSizeMb || '');
        for (const file of files) {
          if (Number.isFinite(maxMb) && file.size > maxMb * 1024 * 1024) {
            return `"${file.name}" is too large. Maximum ${maxMb}MB.`;
          }
        }
      }
      return null;
    }

    form.addEventListener('submit', async (event) => {
      if (form.dataset.provider === 'custom') {
        return;
      }

      event.preventDefault();
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      submitButton?.setAttribute('disabled', 'true');

      const fileError = validateFiles();
      if (fileError) {
        if (status) {
          status.hidden = false;
          status.textContent = fileError;
        }
        submitButton?.removeAttribute('disabled');
        return;
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        const result = await wasSubmissionSuccessful(response, form.dataset.provider);

        if (status) {
          status.hidden = false;
          status.textContent = result.ok
            ? form.dataset.successMessage ?? 'Thank you — your message has been sent.'
            : result.message ?? form.dataset.errorMessage ?? 'Something went wrong. Please try again.';
        }

        if (result.ok) {
          form.reset();
        }
      } catch {
        if (status) {
          status.hidden = false;
          status.textContent =
            form.dataset.errorMessage ?? 'Unable to send your message. Please try again later.';
        }
      } finally {
        submitButton?.removeAttribute('disabled');
      }
    });
  }

  function initContactForms() {
    document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach(bindContactForm);
  }

  initContactForms();
  document.addEventListener('astro:page-load', initContactForms);
</script>
