---
interface Props {
  name: string;
  label: string;
  options: { value: string; label: string }[];
  required?: boolean;
  id?: string;
}

const { name, label, options, required = false, id = name } = Astro.props;
---

<div>
  <label for={id} class="block text-small text-fg-label">
    {label}
    {required && <span class="text-accent"> *</span>}
  </label>
  <select
    id={id}
    name={name}
    required={required}
    class="mt-1 block w-full rounded-input border px-4 py-2.5 text-fg shadow-sm focus:border-accent focus:ring-1 focus:ring-accent"
  >
    <option value="">Select an option</option>
    {options.map((option) => (
      <option value={option.value}>{option.label}</option>
    ))}
  </select>
</div>
