---
import type { FaqItem } from '@/config/faq';
import SectionWrapper from '@/components/utility/SectionWrapper.astro';

interface Props {
  heading?: string;
  subheading?: string;
  items: FaqItem[];
}

const { heading = 'Frequently asked questions', subheading, items } = Astro.props;
---

<SectionWrapper background="neutral">
  <div class="max-w-3xl">
    {
      (heading || subheading) && (
        <div>
          {heading && <h2 class="text-h2 font-bold text-fg">{heading}</h2>}
          {subheading && <p class="mt-4 text-fg-soft">{subheading}</p>}
        </div>
      )
    }

    <div class:list={[(heading || subheading) && 'mt-10', 'space-y-4']}>
      {
        items.map((item, index) => (
          <details class="group surface-card p-5">
            <summary class="cursor-pointer list-none font-semibold text-fg marker:content-none [&::-webkit-details-marker]:hidden">
              <span class="flex items-center justify-between gap-4">
                {item.question}
                <span
                  class="text-accent transition-transform group-open:rotate-45"
                  aria-hidden="true"
                >
                  +
                </span>
              </span>
            </summary>
            <p class="mt-4 text-fg-soft" id={`faq-answer-${index}`}>
              {item.answer}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</SectionWrapper>

<script>
  document.querySelectorAll('details').forEach((detail) => {
    detail.addEventListener('toggle', () => {
      if (detail.open) {
        document.querySelectorAll('details[open]').forEach((other) => {
          if (other !== detail) (other as HTMLDetailsElement).open = false;
        });
      }
    });
  });
</script>
