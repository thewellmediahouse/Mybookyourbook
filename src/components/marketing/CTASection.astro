---
import Button from '@/components/ui/Button.astro';
import SectionWrapper from '@/components/utility/SectionWrapper.astro';

interface Props {
  heading?: string;
  subheading?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  background?: 'primary' | 'secondary' | 'neutral';
}

const {
  heading = 'Ready to get started?',
  subheading = 'Tell us about your goals and we will recommend the right next step.',
  primaryCta = { label: 'Contact us', href: '/contact' },
  secondaryCta,
  background = 'primary',
} = Astro.props;

const bgMap = {
  primary: 'bg-primary text-white',
  secondary: 'bg-secondary text-white',
  neutral: 'surface-panel text-fg',
};

const subtextClass = background === 'neutral' ? 'text-fg-soft' : 'text-white/90';
---

<SectionWrapper padding="sm" class={bgMap[background]}>
  <div class="max-w-3xl">
    <h2 class="text-h2 font-bold">{heading}</h2>
    <p class:list={['mt-4 text-lg', subtextClass]}>
      {subheading}
    </p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href={primaryCta.href} variant="accent" size="lg">
        {primaryCta.label}
      </Button>
      {
        secondaryCta && (
          <Button
            href={secondaryCta.href}
            variant={background === 'neutral' ? 'outline' : 'outline-contrast'}
            size="lg"
          >
            {secondaryCta.label}
          </Button>
        )
      }
    </div>
  </div>
</SectionWrapper>
