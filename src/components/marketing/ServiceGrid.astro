---
import type { Service } from '@/config/services';
import type { ServicePackages } from '@/config/packages';
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';
import PackageTierCard from '@/components/marketing/PackageTierCard.astro';
import SectionWrapper from '@/components/utility/SectionWrapper.astro';
import {
  buildPackageAccentStyleAttribute,
  isRecommendedTier,
} from '@/utils/packageAccent';

interface Props {
  heading?: string;
  subheading?: string;
  services: Service[];
  packageGroups?: ServicePackages[];
  showDetailsLink?: boolean;
}

const {
  heading = 'Our Services',
  subheading,
  services,
  packageGroups,
  showDetailsLink = true,
} = Astro.props;

const packageByServiceId = new Map(
  (packageGroups ?? []).map((group) => [group.serviceId, group]),
);

const iconMap: Record<NonNullable<Service['icon']>, string> = {
  strategy: '◎',
  design: '◆',
  development: '⬡',
  marketing: '▲',
  support: '●',
};
---

<SectionWrapper>
  <div class="max-w-3xl">
    <h2 class="text-h2 font-bold text-fg">{heading}</h2>
    {subheading && <p class="mt-4 text-fg-soft">{subheading}</p>}
  </div>

  {
    packageGroups ? (
      <div class="mt-12 space-y-16">
        {services.map((service) => {
          const group = packageByServiceId.get(service.id);
          const accentStyle = buildPackageAccentStyleAttribute(group?.accent);

          if (group && group.tiers.length > 0) {
            return (
              <div id={service.slug} class="package-tier-group" style={accentStyle}>
                <div class="max-w-3xl">
                  {service.icon && (
                    <div
                      class="package-tier-icon-wrap mb-4 flex h-12 w-12 items-center justify-center rounded-card text-xl"
                      aria-hidden="true"
                    >
                      {iconMap[service.icon]}
                    </div>
                  )}
                  <h3 class="text-h3 font-semibold text-fg">{service.name}</h3>
                  <p class="mt-3 text-fg-soft">{service.description}</p>
                  {service.benefits.length > 0 && (
                    <ul class="mt-4 space-y-1 text-small text-fg-soft">
                      {service.benefits.map((benefit) => (
                        <li class="flex gap-2">
                          <span class="package-tier-accent" aria-hidden="true">✓</span>
                          {benefit}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
                <div class="mt-6 grid gap-6 lg:grid-cols-3">
                  {group.tiers.map((tier) => (
                    <PackageTierCard
                      tier={tier}
                      featured={isRecommendedTier(group.recommendedTierId, tier.id)}
                    />
                  ))}
                </div>
              </div>
            );
          }

          return (
            <Card id={service.slug} class="flex flex-col">
              {service.icon && (
                <div
                  class="mb-4 flex h-12 w-12 items-center justify-center rounded-card bg-accent/10 text-xl text-accent"
                  aria-hidden="true"
                >
                  {iconMap[service.icon]}
                </div>
              )}
              <h3 class="text-h4 font-semibold text-fg">{service.name}</h3>
              <p class="mt-2 flex-1 text-fg-soft">{service.description}</p>
              {service.benefits.length > 0 && (
                <ul class="mt-4 space-y-1 text-small text-fg-soft">
                  {service.benefits.slice(0, 3).map((benefit) => (
                    <li class="flex gap-2">
                      <span class="text-accent" aria-hidden="true">✓</span>
                      {benefit}
                    </li>
                  ))}
                </ul>
              )}
            </Card>
          );
        })}
      </div>
    ) : (
      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {services.map((service) => (
          <Card id={service.slug} class="flex flex-col">
            {service.icon && (
              <div
                class="mb-4 flex h-12 w-12 items-center justify-center rounded-card bg-accent/10 text-xl text-accent"
                aria-hidden="true"
              >
                {iconMap[service.icon]}
              </div>
            )}
            <h3 class="text-h4 font-semibold text-fg">
              <a href={`/services#${service.slug}`} class="hover:text-accent">
                {service.name}
              </a>
            </h3>
            <p class="mt-2 flex-1 text-fg-soft">{service.description}</p>
            {service.benefits.length > 0 && (
              <ul class="mt-4 space-y-1 text-small text-fg-soft">
                {service.benefits.slice(0, 3).map((benefit) => (
                  <li class="flex gap-2">
                    <span class="text-accent" aria-hidden="true">✓</span>
                    {benefit}
                  </li>
                ))}
              </ul>
            )}
          </Card>
        ))}
      </div>
    )
  }

  {
    showDetailsLink && (
      <div class="mt-10">
        <Button href="/services" variant="outline">
          View all services
        </Button>
      </div>
    )
  }
</SectionWrapper>
