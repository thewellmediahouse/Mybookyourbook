---
interface Props {
  label: string;
  active?: boolean;
  class?: string;
}

const { label, active = false, class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full px-4 py-2 text-small font-medium transition-colors',
    active ? 'btn-accent' : 'surface-card text-fg-soft',
    className,
  ]}
>
  {label}
</span>
