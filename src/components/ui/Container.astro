---
interface Props {
  size?: 'default' | 'narrow' | 'wide';
  class?: string;
}

const { size = 'default', class: className = '' } = Astro.props;

const sizes = {
  default: '',
  narrow: 'max-w-3xl',
  wide: 'max-w-7xl',
};
---

<div class:list={['container', sizes[size], className]}>
  <slot />
</div>
