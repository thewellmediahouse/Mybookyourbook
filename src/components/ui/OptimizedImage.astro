---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  width: number;
  height: number;
  widths?: number[];
  sizes?: string;
  /** When set, emits a mobile <source> so narrow viewports cannot pick desktop rungs. */
  mobileWidths?: number[];
  mobileSizes?: string;
  mobileMedia?: string;
  quality?: number;
  fit?: 'cover' | 'contain' | 'fill' | 'inside' | 'outside';
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'auto' | 'sync';
}

const {
  src,
  alt,
  class: className,
  width,
  height,
  widths = [width, width * 2],
  sizes = `(max-width: 1024px) 100vw, ${width}px`,
  mobileWidths,
  mobileSizes = '(max-width: 768px) 100vw',
  mobileMedia = '(max-width: 768px)',
  quality = 88,
  fit = 'cover',
  loading = 'lazy',
  fetchpriority,
  decoding = 'async',
} = Astro.props;

const mobileSrcset = mobileWidths?.length
  ? (
      await Promise.all(
        mobileWidths.map((w) =>
          getImage({
            src,
            width: w,
            format: 'webp',
            quality,
            fit,
          }),
        ),
      )
    )
      .map((img, i) => `${img.src} ${mobileWidths[i]}w`)
      .join(', ')
  : null;
---

{
  mobileSrcset ? (
    <picture>
      <source media={mobileMedia} srcset={mobileSrcset} sizes={mobileSizes} />
      <Image
        src={src}
        alt={alt}
        format="webp"
        widths={widths}
        sizes={sizes}
        quality={quality}
        width={width}
        height={height}
        fit={fit}
        class={className}
        loading={loading}
        fetchpriority={fetchpriority}
        decoding={decoding}
      />
    </picture>
  ) : (
    <Image
      src={src}
      alt={alt}
      format="webp"
      widths={widths}
      sizes={sizes}
      quality={quality}
      width={width}
      height={height}
      fit={fit}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
    />
  )
}
