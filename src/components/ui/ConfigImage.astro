---
/**
 * Config-driven image: `src` may be a `raster.ts` key or a public/remote URL.
 * Rasters use OptimizedImage (mobile srcset by default). SVG/icons and URLs stay `<img>`.
 */
import OptimizedImage from '@/components/ui/OptimizedImage.astro';
import { resolveConfigImage } from '@/utils/media';
import { isUnoptimizableSrc } from '@/utils/responsive-image';

interface Props {
  src: string;
  alt: string;
  class?: string;
  width: number;
  height: number;
  widths?: number[];
  sizes?: string;
  mobileWidths?: number[];
  mobileSizes?: string;
  mobileMedia?: string;
  quality?: number;
  fit?: 'cover' | 'contain' | 'fill' | 'inside' | 'outside';
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'auto' | 'sync';
}

const {
  src,
  alt,
  class: className,
  width,
  height,
  widths,
  sizes,
  mobileWidths,
  mobileSizes,
  mobileMedia,
  quality,
  fit,
  loading = 'lazy',
  fetchpriority,
  decoding = 'async',
} = Astro.props;

const resolved = resolveConfigImage(src);
const useAstroPipeline = resolved?.kind === 'raster' && !isUnoptimizableSrc(src);
---

{
  useAstroPipeline && resolved?.kind === 'raster' ? (
    <OptimizedImage
      src={resolved.src}
      alt={alt}
      class={className}
      width={width}
      height={height}
      widths={widths}
      sizes={sizes}
      mobileWidths={mobileWidths}
      mobileSizes={mobileSizes}
      mobileMedia={mobileMedia}
      quality={quality}
      fit={fit}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
    />
  ) : (
    <img
      src={resolved?.kind === 'url' ? resolved.src : src}
      alt={alt}
      width={width}
      height={height}
      class={className}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding={decoding}
    />
  )
}
