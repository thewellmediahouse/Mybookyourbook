---
interface Props {
  /** Primary line — default heading colour */
  heading: string;
  /** Optional second line — gold gradient (`text-gradient-gold`) */
  headingHighlight?: string;
  class?: string;
}

const { heading, headingHighlight, class: className = '' } = Astro.props;
---

<h1 class={`text-display font-bold ${className}`}>
  {
    headingHighlight ? (
      <>
        <span class="block text-fg">{heading}</span>
        <span class="block text-gradient-gold">{headingHighlight}</span>
      </>
    ) : (
      <span class="text-fg">{heading}</span>
    )
  }
</h1>
