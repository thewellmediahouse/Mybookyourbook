---
import type { NavItem } from '@/config/navigation';

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function normalizeHref(href: string) {
  return href.replace(/\/$/, '').split('#')[0] || '/';
}
---

<button
  type="button"
  class="inline-flex items-center justify-center rounded-button p-2 text-fg-soft hover:bg-white/10 lg:hidden"
  aria-expanded="false"
  aria-controls="mobile-nav-panel"
  data-mobile-nav-toggle
>
  <span class="sr-only">Open menu</span>
  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
  </svg>
</button>

<div
  id="mobile-nav-panel"
  class="header-glass absolute left-0 right-0 top-16 hidden border-b lg:hidden"
  data-mobile-nav-panel
>
  <nav aria-label="Mobile navigation" class="container py-4">
    <ul class="flex flex-col gap-1">
      {
        items.map((item) => {
          const href = normalizeHref(item.href);
          const isActive =
            currentPath === href || (href !== '/' && currentPath.startsWith(`${href}/`));
          const hasChildren = Boolean(item.children?.length);

          if (!hasChildren) {
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'block rounded-button px-3 py-3 text-body font-medium',
                    isActive ? 'text-accent' : 'text-fg-soft hover:bg-white/5',
                  ]}
                  aria-current={currentPath === href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          }

          return (
            <li>
              <a
                href={item.href}
                class:list={[
                  'block rounded-button px-3 py-3 text-body font-medium',
                  currentPath === href ? 'text-accent' : isActive ? 'text-accent' : 'text-fg-soft hover:bg-white/5',
                ]}
                aria-current={currentPath === href ? 'page' : undefined}
              >
                {item.label}
              </a>
              <ul class="mb-2 ml-3 mt-1 space-y-0.5 border-l border-[var(--color-border)] pl-3">
                {item.children!.map((child) => {
                  const childPath = normalizeHref(child.href);
                  const childActive =
                    currentPath === childPath ||
                    (childPath !== '/' && currentPath.startsWith(`${childPath}/`));
                  return (
                    <li>
                      <a
                        href={child.href}
                        class:list={[
                          'block rounded-button px-3 py-2.5 text-small font-medium',
                          childActive ? 'text-accent' : 'text-fg-muted hover:bg-white/5 hover:text-fg',
                        ]}
                        aria-current={childActive ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </li>
          );
        })
      }
    </ul>
  </nav>
</div>
