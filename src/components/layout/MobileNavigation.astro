---
import type { NavItem } from '@/config/navigation';

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isItemActive(item: NavItem): boolean {
  const href = item.href.replace(/\/$/, '') || '/';
  if (currentPath === href) return true;
  return Boolean(item.children?.some((child) => isItemActive(child)));
}
---

<button
  type="button"
  class="inline-flex items-center justify-center rounded-button p-2 text-fg-soft hover:bg-white/10 lg:hidden"
  aria-expanded="false"
  aria-controls="mobile-nav-panel"
  data-mobile-nav-toggle
>
  <span class="sr-only">Open menu</span>
  <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
  </svg>
</button>

<div
  id="mobile-nav-panel"
  class="header-glass absolute left-0 right-0 top-16 hidden border-b lg:hidden"
  data-mobile-nav-panel
>
  <nav aria-label="Mobile navigation" class="container py-4">
    <ul class="flex flex-col gap-1">
      {
        items.map((item) => {
          const isActive = isItemActive(item);
          const hasChildren = Boolean(item.children?.length);

          if (!hasChildren) {
            const href = item.href.replace(/\/$/, '') || '/';
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'block rounded-button px-3 py-3 text-body font-medium',
                    isActive ? 'text-accent' : 'text-fg-soft hover:bg-white/5',
                  ]}
                  aria-current={currentPath === href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          }

          return (
            <li class="border-b border-white/5 pb-2 mb-1">
              <p
                class:list={[
                  'px-3 py-2 text-xs font-semibold uppercase tracking-[0.14em]',
                  isActive ? 'text-accent' : 'text-fg-muted',
                ]}
              >
                {item.label}
              </p>
              <ul class="flex flex-col gap-0.5">
                {item.children!.map((child) => {
                  const childHref = child.href.replace(/\/$/, '') || '/';
                  const childActive = currentPath === childHref;
                  return (
                    <li>
                      <a
                        href={child.href}
                        class:list={[
                          'block rounded-button px-3 py-2.5 pl-5 text-body font-medium',
                          childActive ? 'text-accent' : 'text-fg-soft hover:bg-white/5',
                        ]}
                        aria-current={childActive ? 'page' : undefined}
                      >
                        {child.label}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </li>
          );
        })
      }
    </ul>
  </nav>
</div>
