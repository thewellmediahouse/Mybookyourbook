---
import PlayButton from '@/components/media/PlayButton.astro';
import { getCategoryLabel, type PortfolioItem } from '@/config/portfolio';

interface Props {
  item: PortfolioItem;
  class?: string;
}

const { item, class: className = '' } = Astro.props;
const categoryLabel = getCategoryLabel(item.category);
const href = `/portfolio/${item.slug}`;
---

<a
  href={href}
  class={`group surface-card block overflow-hidden transition hover:shadow-elevated ${className}`}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-black/20">
    <img
      src={item.image}
      alt={item.imageAlt}
      width="600"
      height="450"
      class="h-full w-full object-cover transition group-hover:scale-[1.02]"
      loading="lazy"
    />
    {item.isVideo && (
      <div class="absolute inset-0 flex items-center justify-center bg-black/30">
        <PlayButton />
      </div>
    )}
  </div>
  <div class="p-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-accent">{categoryLabel}</p>
    <h3 class="mt-2 text-h4 font-semibold text-fg">{item.title}</h3>
    <p class="mt-2 text-small text-fg-soft">{item.description}</p>
  </div>
</a>
