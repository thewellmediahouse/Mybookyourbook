---
interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { class: className = '', size = 'md' } = Astro.props;

const sizeClasses = {
  sm: 'h-10 w-10',
  md: 'h-14 w-14',
  lg: 'h-16 w-16',
};
---

<span
  class:list={[
    'btn-accent inline-flex items-center justify-center rounded-full shadow-elevated',
    sizeClasses[size],
    className,
  ]}
  aria-hidden="true"
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-1/2 w-1/2 translate-x-0.5">
    <path d="M8 5v14l11-7z" />
  </svg>
</span>
