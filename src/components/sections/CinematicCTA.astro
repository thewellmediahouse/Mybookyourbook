---
import Button from '@/components/ui/Button.astro';
import type { CtaBlock } from '@/config/content';
import type { ImageMetadata } from 'astro';
import OptimizedImage from '@/components/ui/OptimizedImage.astro';

interface Props extends CtaBlock {
  backgroundImage?: ImageMetadata | string;
}

const { heading, primaryCta, backgroundImage } = Astro.props;

function isImageMetadata(value: unknown): value is ImageMetadata {
  return typeof value === 'object' && value !== null && 'src' in value && 'width' in value && 'height' in value;
}
---

<section class="cinematic-cta relative overflow-hidden py-section">
  {
    backgroundImage &&
      (isImageMetadata(backgroundImage) ? (
        <OptimizedImage
          src={backgroundImage}
          alt=""
          width={1920}
          height={1080}
          widths={[640, 960, 1280, 1920]}
          sizes="100vw"
          class="cinematic-cta__image"
          loading="lazy"
        />
      ) : (
        <img
          src={backgroundImage}
          alt=""
          width="1920"
          height="1080"
          class="cinematic-cta__image"
          loading="lazy"
          aria-hidden="true"
        />
      ))
  }
  <div class="cinematic-cta__overlay" aria-hidden="true" />
  <div class="container relative z-10">
    <div class="cinematic-cta__content scroll-reveal mx-auto max-w-3xl text-center">
      <h2 class="text-h2 font-bold text-fg lg:text-[2.35rem]">{heading}</h2>
      <div class="mt-8 flex justify-center">
        <Button href={primaryCta.href} variant="accent" size="lg" class="w-full sm:w-auto">
          {primaryCta.label}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .cinematic-cta {
    min-height: clamp(20rem, 38vw, 28rem);
    display: flex;
    align-items: center;
  }

  :global(.cinematic-cta__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .cinematic-cta__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(3 15 30 / 0.88) 0%,
      rgb(3 15 30 / 0.72) 45%,
      rgb(3 15 30 / 0.55) 100%
    );
  }

  .cinematic-cta__content {
    padding: 2rem 0;
  }
</style>
