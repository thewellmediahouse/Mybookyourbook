---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { PhaseCard } from '@/config/content';

interface Props {
  intro: string;
  phases: PhaseCard[];
}

const { intro, phases } = Astro.props;
---

<section class="py-section">
  <div class="container">
    <SectionHeading heading="Flexible implementation" subheading={intro} class="mb-10" />
    <div class="grid gap-6 md:grid-cols-3">
      {phases.map((phase) => (
        <div class="surface-card p-6">
          <p class="text-small font-semibold uppercase tracking-wide text-accent">Phase {phase.phase}</p>
          <h3 class="mt-2 text-h4 font-semibold text-fg">{phase.title}</h3>
          <p class="mt-3 text-fg-soft">{phase.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
