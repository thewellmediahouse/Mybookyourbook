---
import HeroDecorBackground from '@/components/decor/HeroDecorBackground.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import ConfigImage from '@/components/ui/ConfigImage.astro';
import HeroHeading from '@/components/ui/HeroHeading.astro';
import VideoPlaceholder from '@/components/media/VideoPlaceholder.astro';
import type { HeroContent } from '@/config/content';

interface Props extends HeroContent {
  eyebrow?: string;
}

const {
  layout = 'split',
  eyebrow,
  heading,
  headingHighlight,
  subheading,
  paragraph,
  trustPoints,
  primaryCta,
  secondaryCta,
  overlayOpacity,
  decor,
  media,
} = Astro.props;

const isFullBleed = layout === 'fullBleed';
const decorEnabled = decor?.enabled !== false;

const heroBackground =
  decorEnabled && decor?.video?.src
    ? {
        type: 'video' as const,
        src: decor.video.src,
        poster: decor.video.poster,
        opacity: decor.opacity ?? 1,
      }
    : decorEnabled && decor?.image?.src
      ? {
          type: 'image' as const,
          src: decor.image.src,
          alt: decor.image.alt ?? '',
          opacity: decor.opacity ?? 1,
        }
      : undefined;

const fullBleedHasMedia =
  isFullBleed && media?.type !== 'none' && Boolean(media?.src || media?.type === 'image');

const fullBleedIsVideo = isFullBleed && media?.type === 'video' && Boolean(media.src);
const fullBleedIsImage = isFullBleed && media?.type !== 'video' && media?.type !== 'none' && Boolean(media?.src);

const scrimOpacity = Math.min(1, Math.max(0, overlayOpacity ?? 0.55));
---

{
  isFullBleed ? (
    <section
      class="hero-fullbleed relative flex min-h-[min(92vh,56rem)] flex-col justify-end overflow-hidden"
      style={`--hero-scrim-opacity: ${scrimOpacity}`}
    >
      {
        fullBleedIsVideo && (
          <div class="hero-fullbleed-media absolute inset-0" aria-hidden="true">
            <video
              class="h-full w-full object-cover"
              src={media!.src}
              poster={media!.poster}
              autoplay
              muted
              loop
              playsinline
            />
          </div>
        )
      }
      {
        fullBleedIsImage && media?.src && (
          <div class="hero-fullbleed-media absolute inset-0" aria-hidden={media.alt ? undefined : 'true'}>
            <ConfigImage
              src={media.src}
              alt={media.alt ?? ''}
              width={1920}
              height={1080}
              widths={[960, 1280, 1600, 1920]}
              sizes="100vw"
              mobileWidths={[640, 828, 1080]}
              class="h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        )
      }
      {
        !fullBleedHasMedia && heroBackground && (
          <HeroDecorBackground
            type={heroBackground.type}
            src={heroBackground.src}
            alt={'alt' in heroBackground ? heroBackground.alt : undefined}
            poster={'poster' in heroBackground ? heroBackground.poster : undefined}
            opacity={heroBackground.opacity}
          />
        )
      }
      <div class="hero-fullbleed-scrim absolute inset-0" aria-hidden="true" />
      <div class="container relative z-10 pb-16 pt-28 md:pb-24 md:pt-36">
        <div class="max-w-2xl">
          {eyebrow && <Badge class="mb-4">{eyebrow}</Badge>}
          {
            subheading && (
              <p class="mb-3 text-small font-semibold uppercase tracking-wide text-accent">
                {subheading}
              </p>
            )
          }
          <HeroHeading heading={heading} headingHighlight={headingHighlight} />
          {paragraph && <p class="mt-6 max-w-xl text-lg text-fg-soft">{paragraph}</p>}
          <div class="mt-8 flex flex-wrap gap-4">
            <Button href={primaryCta.href} variant="accent" size="lg">
              {primaryCta.label}
            </Button>
            {
              secondaryCta && (
                <Button href={secondaryCta.href} variant="outline-contrast" size="lg">
                  {secondaryCta.label}
                </Button>
              )
            }
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="section-hero relative overflow-hidden py-section">
      {heroBackground && (
        <HeroDecorBackground
          type={heroBackground.type}
          src={heroBackground.src}
          alt={'alt' in heroBackground ? heroBackground.alt : undefined}
          poster={'poster' in heroBackground ? heroBackground.poster : undefined}
          opacity={heroBackground.opacity}
        />
      )}
      <div class="container">
        <div class="grid items-center gap-12 lg:grid-cols-2">
          <div class="relative">
            {eyebrow && <Badge class="mb-4">{eyebrow}</Badge>}
            {
              subheading && (
                <p class="mb-3 text-small font-semibold uppercase tracking-wide text-accent">
                  {subheading}
                </p>
              )
            }
            <HeroHeading heading={heading} headingHighlight={headingHighlight} />
            {paragraph && <p class="mt-6 max-w-xl text-lg text-fg-soft">{paragraph}</p>}
            {
              trustPoints && trustPoints.length > 0 && (
                <ul class="mt-6 space-y-2 text-fg-soft">
                  {trustPoints.map((point) => (
                    <li class="flex gap-2">
                      <span class="text-accent" aria-hidden="true">✓</span>
                      {point}
                    </li>
                  ))}
                </ul>
              )
            }
            <div class="mt-8 flex flex-wrap gap-4">
              <Button href={primaryCta.href} variant="accent" size="lg">
                {primaryCta.label}
              </Button>
              {
                secondaryCta && (
                  <Button href={secondaryCta.href} variant="outline-contrast" size="lg">
                    {secondaryCta.label}
                  </Button>
                )
              }
            </div>
          </div>
          {
            media?.type !== 'none' && (
              <div class="relative">
                {
                  media?.type === 'video' ? (
                    <VideoPlaceholder
                      src={media.src}
                      alt={media.alt}
                      caption={media.caption}
                      videoUrl={media.videoUrl}
                    />
                  ) : (
                    <div class="media-video-frame aspect-[4/3]">
                      <ConfigImage
                        src={media?.src ?? '/images/video-placeholder.svg'}
                        alt={media?.alt ?? ''}
                        width={800}
                        height={600}
                        widths={[480, 720, 960]}
                        sizes="(max-width: 1024px) 100vw, 50vw"
                        mobileWidths={[480, 640, 828]}
                        class="absolute inset-0 h-full w-full object-cover"
                        loading="eager"
                        fetchpriority="high"
                      />
                    </div>
                  )
                }
              </div>
            )
          }
        </div>
      </div>
    </section>
  )
}
