---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { ProcessStep } from '@/config/content';

interface Props {
  heading?: string;
  steps: ProcessStep[];
}

const { heading = 'How we work', steps } = Astro.props;
---

<section class="py-section">
  <div class="container">
    <SectionHeading heading={heading} class="scroll-reveal mb-12" />
    <ol class="process-timeline scroll-reveal">
      {
        steps.map((step, index) => (
          <li class="process-timeline__step">
            <div class="process-timeline__marker">
              <span class="process-timeline__number">{step.step}</span>
            </div>
            {index < steps.length - 1 && (
              <span class="process-timeline__line hidden lg:block" aria-hidden="true" />
            )}
            <div class="process-timeline__content">
              <h3 class="text-h4 font-semibold text-fg">{step.title}</h3>
              <p class="mt-2 text-fg-soft">{step.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process-timeline {
    display: grid;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 1024px) {
    .process-timeline {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .process-timeline__step {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem 1.25rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .process-timeline__step {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.25rem;
    }
  }

  .process-timeline__marker {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
  }

  .process-timeline__number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, rgb(255 217 119 / 0.2), rgb(224 169 56 / 0.12));
    border: 1px solid rgb(224 169 56 / 0.45);
    color: var(--brand-accent-light, #f3c45e);
    font-size: 1rem;
    font-weight: 700;
    box-shadow: 0 0 24px rgb(224 169 56 / 0.15);
  }

  .process-timeline__line {
    position: absolute;
    top: 1.5rem;
    left: calc(50% + 1.75rem);
    width: calc(100% - 3.5rem);
    height: 2px;
    background: linear-gradient(
      90deg,
      rgb(224 169 56 / 0.45),
      rgb(224 169 56 / 0.15)
    );
  }

  .process-timeline__content {
    padding-top: 0.125rem;
  }

  @media (min-width: 1024px) {
    .process-timeline__content {
      padding-top: 0;
    }
  }
</style>
