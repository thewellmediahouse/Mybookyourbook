---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { ProcessStep } from '@/config/content';

interface Props {
  heading?: string;
  steps: ProcessStep[];
}

const { heading = 'How we work', steps } = Astro.props;
---

<section class="py-section">
  <div class="container">
    <SectionHeading heading={heading} class="mb-10" />
    <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((step) => (
        <li class="surface-card p-6">
          <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-accent/20 text-small font-bold text-accent">
            {step.step}
          </span>
          <h3 class="mt-4 text-h4 font-semibold text-fg">{step.title}</h3>
          <p class="mt-2 text-fg-soft">{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
