---
interface Props {
  image: string;
  imageAlt: string;
  width: number;
  height: number;
}

const { image, imageAlt, width, height } = Astro.props;
---

<section class="live-event-sales" aria-label="Live event sales case study">
  <div class="container">
    <figure class="live-event-sales__frame scroll-reveal">
      <img
        src={image}
        alt={imageAlt}
        width={width}
        height={height}
        class="live-event-sales__image"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="sr-only">
        The Well Media generated R120,000 in book sales in one month through five strategic live
        events without Facebook ads. Smart strategy beats random ad spend.
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .live-event-sales {
    position: relative;
    padding: 0 0 clamp(3rem, 5vw, 4.5rem);
    margin-top: -0.5rem;
  }

  .live-event-sales__frame {
    margin: 0;
    overflow: hidden;
    border-radius: 24px;
    border: 1px solid rgb(214 166 62 / 0.28);
    background: rgb(5 16 30 / 0.82);
    box-shadow:
      0 0 45px rgb(214 166 62 / 0.08),
      inset 0 1px 0 rgb(255 255 255 / 0.04);
    transition:
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }

  .live-event-sales__frame:hover {
    border-color: rgb(247 198 87 / 0.55);
    box-shadow:
      0 0 45px rgb(214 166 62 / 0.16),
      inset 0 1px 0 rgb(255 255 255 / 0.06);
  }

  .live-event-sales__image {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
