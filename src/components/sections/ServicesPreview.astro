---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Card from '@/components/ui/Card.astro';
import type { Service } from '@/config/services';

interface Props {
  heading: string;
  subheading?: string;
  services: Service[];
}

const { heading, subheading, services } = Astro.props;
---

<section id="services" class="section-surface py-section">
  <div class="container">
    <SectionHeading heading={heading} subheading={subheading} class="mb-10" />
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <Card>
          <h3 class="text-h4 font-semibold">{service.name}</h3>
          <p class="mt-3 text-fg-soft">{service.shortDescription}</p>
        </Card>
      ))}
    </div>
  </div>
</section>
