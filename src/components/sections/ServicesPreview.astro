---
import type { ImageMetadata } from 'astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import OptimizedImage from '@/components/ui/OptimizedImage.astro';
import type { HomeServiceCard } from '@/config/content';

interface Props {
  eyebrow?: string;
  heading: string;
  subheading?: string;
  services: HomeServiceCard[];
}

const { eyebrow, heading, subheading, services } = Astro.props;

function isImageMetadata(value: unknown): value is ImageMetadata {
  return typeof value === 'object' && value !== null && 'src' in value && 'width' in value && 'height' in value;
}
---

<section id="services" class="section-surface py-section">
  <div class="container">
    <SectionHeading
      eyebrow={eyebrow}
      heading={heading}
      subheading={subheading}
      align="center"
      class="scroll-reveal mx-auto mb-12"
    />
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service, index) => (
          <li
            class="premium-card service-image-card scroll-reveal overflow-hidden"
            style={`--reveal-delay: ${index * 60}ms`}
          >
            <div class="service-image-card__media relative aspect-[16/10] overflow-hidden bg-black/30">
              {
                isImageMetadata(service.image) ? (
                  <OptimizedImage
                    src={service.image}
                    alt={service.imageAlt}
                    width={640}
                    height={400}
                    widths={[320, 480, 640, 960]}
                    sizes="(max-width: 768px) 90vw, (max-width: 1024px) 45vw, 280px"
                    class="service-image-card__image h-full w-full object-cover"
                    loading="lazy"
                  />
                ) : (
                  <img
                    src={service.image}
                    alt={service.imageAlt}
                    width="640"
                    height="400"
                    class="service-image-card__image h-full w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                )
              }
            </div>
            <div class="service-image-card__body p-5">
              <h3 class="text-h4 font-semibold text-fg">{service.name}</h3>
              <p class="mt-3 text-small text-fg-soft">{service.description}</p>
              {
                service.href && (
                  <a
                    href={service.href}
                    class="mt-4 inline-flex items-center gap-1 text-small font-semibold text-accent transition hover:gap-2"
                  >
                    Learn More <span aria-hidden="true">→</span>
                  </a>
                )
              }
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .service-image-card {
    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .service-image-card:hover {
    transform: translateY(-6px);
    border-color: rgb(224 169 56 / 0.45);
    box-shadow:
      0 24px 80px rgb(0 0 0 / 0.28),
      0 0 40px rgb(224 169 56 / 0.1);
  }

  :global(.service-image-card__image) {
    transition: transform 0.45s ease;
  }

  .service-image-card:hover :global(.service-image-card__image) {
    transform: scale(1.015);
  }

  .service-image-card__body {
    background: linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.02));
    border-top: 1px solid rgb(224 169 56 / 0.12);
  }
</style>
