---
import Container from '@/components/ui/Container.astro';

interface Props {
  heading: string;
  paragraph: string;
  bullets: readonly string[];
}

const { heading, paragraph, bullets } = Astro.props;
---

<section class="surface-panel py-section-sm">
  <Container>
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-h2 font-bold text-fg">{heading}</h2>
        <p class="mt-4 text-lg text-fg-soft">{paragraph}</p>
      </div>
      <ul class="space-y-3">
        {bullets.map((bullet) => (
          <li class="surface-card flex gap-3 px-4 py-3 text-fg-soft">
            <span class="text-accent" aria-hidden="true">✓</span>
            {bullet}
          </li>
        ))}
      </ul>
    </div>
  </Container>
</section>
