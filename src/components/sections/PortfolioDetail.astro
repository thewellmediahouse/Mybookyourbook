---
import VideoPlaceholder from '@/components/media/VideoPlaceholder.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Card from '@/components/ui/Card.astro';
import { getCategoryLabel, portfolioConfig, type PortfolioItem } from '@/config/portfolio';
import { isVideoUrl, resolveVideoUrl, resolveVideoPosterSrc } from '@/utils/videoEmbed';

interface Props {
  item: PortfolioItem;
}

const { item } = Astro.props;
const detail = item.detail;
const categoryLabel = getCategoryLabel(item.category);
const summary = detail?.summary ?? item.description;
const meta = detail?.meta;
const videos = detail?.videos ?? [];
const images = detail?.images ?? [];
const testimonial = detail?.testimonial;
const heroVideoUrl = isVideoUrl(item.image)
  ? item.image
  : item.isVideo
    ? resolveVideoUrl(videos[0]?.url, videos[0]?.thumbnail)
    : undefined;
const galleryVideos =
  heroVideoUrl && !isVideoUrl(item.image)
    ? videos.filter((video) => resolveVideoUrl(video.url, video.thumbnail) !== heroVideoUrl)
    : videos;
const heroVideo = videos.find((video) => resolveVideoUrl(video.url, video.thumbnail) === heroVideoUrl);
---

<section class="portfolio-detail-hero py-section-sm">
  <div class="container">
    <a
      href="/portfolio"
      class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-small font-medium text-fg-soft transition hover:bg-white/5 hover:text-accent"
    >
      <span aria-hidden="true">←</span>
      Back to {portfolioConfig.pageTitle}
    </a>

    <p class="mt-8 text-xs font-semibold uppercase tracking-[0.2em] text-accent">{categoryLabel}</p>
    <h1 class="mt-3 max-w-4xl font-display text-h1 font-bold tracking-tight text-fg">{item.title}</h1>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-fg-soft">{summary}</p>

    {
      meta && (meta.client || meta.year || meta.services?.length) && (
        <dl class="portfolio-detail-meta mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {meta.client && (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-fg-muted">Client</dt>
              <dd class="mt-2 font-semibold text-fg">{meta.client}</dd>
            </div>
          )}
          {meta.year && (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-fg-muted">Year</dt>
              <dd class="mt-2 font-semibold text-fg">{meta.year}</dd>
            </div>
          )}
          {meta.services && meta.services.length > 0 && (
            <div class="sm:col-span-2 lg:col-span-1">
              <dt class="text-xs font-semibold uppercase tracking-[0.16em] text-fg-muted">Services</dt>
              <dd class="mt-2 leading-relaxed text-fg-soft">{meta.services.join(' · ')}</dd>
            </div>
          )}
        </dl>
      )
    }

    {
      heroVideoUrl ? (
        <VideoPlaceholder
          class="relative z-[1] mt-12"
          videoUrl={heroVideoUrl}
          src={resolveVideoPosterSrc({
            thumbnail: heroVideo?.thumbnail,
            videoUrl: heroVideoUrl,
            fallbackImage: isVideoUrl(item.image) ? undefined : item.image,
          })}
          alt={heroVideo?.thumbnailAlt ?? item.imageAlt}
          aspect="16/9"
        />
      ) : (
        <div class="media-video-frame relative z-[1] mt-12 aspect-[16/9]">
          <img
            src={item.image}
            alt={item.imageAlt}
            width="1200"
            height="675"
            class="aspect-[16/9] w-full object-cover"
            loading="eager"
          />
        </div>
      )
    }
  </div>
</section>

{
  galleryVideos.length > 0 && (
    <section class="py-section">
      <div class="container">
        <SectionHeading heading="Videos" subheading="Campaign and production cuts from this project." class="mb-10" />
        <div class="grid gap-8 lg:grid-cols-2">
          {galleryVideos.map((video) => (
            <VideoPlaceholder
              src={video.thumbnail}
              alt={video.thumbnailAlt}
              caption={video.caption ?? video.title}
              videoUrl={resolveVideoUrl(video.url, video.thumbnail)}
              aspect="16/9"
            />
          ))}
        </div>
      </div>
    </section>
  )
}

{
  images.length > 0 && (
    <section class="section-surface py-section">
      <div class="container">
        <SectionHeading heading="Gallery" subheading="Photography and stills from this project." class="mb-10" />
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {images.map((image) => (
            <figure class="surface-card overflow-hidden">
              <img
                src={image.src}
                alt={image.alt}
                width="600"
                height="450"
                class="aspect-[4/3] w-full object-cover transition duration-500 hover:scale-[1.02]"
                loading="lazy"
              />
              {image.caption && (
                <figcaption class="border-t border-white/10 bg-white/[0.02] px-4 py-3 text-small text-fg-soft">
                  {image.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  testimonial && (
    <section class="py-section">
      <div class="container">
        <SectionHeading heading="Client feedback" class="mb-10" />
        <Card class="max-w-3xl" padding="default">
          <blockquote class="portfolio-detail-quote">
            <p class="text-xl leading-relaxed text-fg-soft md:text-2xl">
              &ldquo;{testimonial.quote}&rdquo;
            </p>
            <footer class="mt-8 border-t border-white/10 pt-5">
              <cite class="not-italic">
                <span class="font-semibold text-fg">{testimonial.author}</span>
                <span class="mt-1 block text-small text-fg-muted">
                  {testimonial.role}
                  {testimonial.company ? ` · ${testimonial.company}` : ''}
                </span>
              </cite>
            </footer>
          </blockquote>
        </Card>
      </div>
    </section>
  )
}
