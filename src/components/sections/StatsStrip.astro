---
import type { StatItem } from '@/config/content';

interface Props {
  items: StatItem[];
}

const { items } = Astro.props;
---

<section class="border-y border-white/10 bg-primary py-section-sm text-white">
  <div class="container">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((stat) => (
        <div>
          <p class="text-display font-bold text-accent">{stat.value}</p>
          <p class="mt-2 font-semibold text-white">{stat.label}</p>
          {stat.note && <p class="mt-1 text-xs text-white/70">{stat.note}</p>}
        </div>
      ))}
    </div>
  </div>
</section>
