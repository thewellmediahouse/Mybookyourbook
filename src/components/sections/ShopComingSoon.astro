---
import { shopConfig } from '@/config/shop';
import Button from '@/components/ui/Button.astro';
import ConfigImage from '@/components/ui/ConfigImage.astro';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const shop = shopConfig.comingSoon;
---

<section class="py-section">
  <div class="container space-y-12">
    <div class="grid items-center gap-10 lg:grid-cols-2">
      <div class="min-w-0 space-y-6">
        <span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary">
          {shop.eyebrow}
        </span>
        <h1 class="text-h1 font-semibold text-fg">
          {shop.heading}
          {
            shop.headingHighlight && (
              <span class="mt-1 block text-gradient-gold">{shop.headingHighlight}</span>
            )
          }
        </h1>
        <p class="text-lg text-fg-muted">{shop.paragraph}</p>
        <div class="flex flex-wrap gap-3">
          <Button variant="accent" href={shop.primaryCta.href} external={shop.primaryCta.external}>
            {shop.primaryCta.label}
          </Button>
          {
            shop.secondaryCta && (
              <Button
                variant="secondary"
                href={shop.secondaryCta.href}
                external={shop.secondaryCta.external}
              >
                {shop.secondaryCta.label}
              </Button>
            )
          }
        </div>
      </div>
      {
        shop.image && (
          <div class="flex min-w-0 justify-center">
            <ConfigImage
              src={shop.image.src}
              alt={shop.image.alt}
              class="w-full max-w-md object-contain"
              width={500}
              height={400}
              fit="contain"
              loading="eager"
            />
          </div>
        )
      }
    </div>

    {
      !compact && (
        <>
          {shop.note && <p class="text-center text-small text-fg-muted">{shop.note}</p>}
          {shop.categories.length > 0 && (
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {shop.categories.map((category) => (
                <div class="surface-card cursor-not-allowed p-6 opacity-60">
                  <div class="flex items-center justify-between">
                    <h3 class="font-semibold text-fg">{category}</h3>
                    <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
                      Soon
                    </span>
                  </div>
                </div>
              ))}
            </div>
          )}
        </>
      )
    }
  </div>
</section>
