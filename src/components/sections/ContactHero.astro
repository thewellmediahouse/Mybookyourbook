---
import HomeHero from '@/components/sections/HomeHero.astro';
import type { HeroContent } from '@/config/content';

type Props = HeroContent;
---

<div class="contact-hero">
  <HomeHero {...Astro.props} showMobileLogo={false} />
</div>

<style>
  .contact-hero :global(.home-hero__stage) {
    min-height: clamp(26rem, 54vw, 40rem);
  }

  .contact-hero :global(.home-hero__visual) {
    position: relative;
    width: 100%;
    max-width: none;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 1rem;
  }

  .contact-hero :global(.home-hero__visual)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    border-radius: inherit;
    background:
      linear-gradient(90deg, rgb(3 15 30 / 0.7) 0%, transparent 45%),
      linear-gradient(180deg, transparent 58%, rgb(3 15 30 / 0.4) 100%);
  }

  .contact-hero :global(.home-hero__camera) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 44% center;
    filter: drop-shadow(0 24px 64px rgb(0 0 0 / 0.4));
    border-radius: inherit;
    transform: none !important;
    min-width: unset !important;
    -webkit-mask-image:
      linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.4) 12%, #000 32%, #000 100%),
      radial-gradient(ellipse 94% 88% at 52% 50%, #000 48%, transparent 100%) !important;
    mask-image:
      linear-gradient(90deg, transparent 0%, rgb(0 0 0 / 0.4) 12%, #000 32%, #000 100%),
      radial-gradient(ellipse 94% 88% at 52% 50%, #000 48%, transparent 100%) !important;
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  @media (min-width: 1024px) {
    .contact-hero :global(.home-hero__stage) {
      min-height: clamp(32rem, 52vw, 44rem);
    }

    .contact-hero :global(.home-hero__content) {
      z-index: 4;
      max-width: min(100%, 44%);
    }

    .contact-hero :global(.home-hero__visual) {
      position: absolute;
      top: 50%;
      left: 36%;
      right: -6%;
      width: auto;
      height: clamp(26rem, 46vw, 40rem);
      margin: 0;
      transform: translateY(-50%);
      justify-content: flex-end;
      align-items: center;
      z-index: 2;
      border-radius: 0;
      overflow: hidden;
    }

    .contact-hero :global(.home-hero__visual)::after {
      border-radius: 0;
      background:
        linear-gradient(90deg, rgb(3 15 30 / 0.96) 0%, rgb(3 15 30 / 0.7) 12%, rgb(3 15 30 / 0.2) 34%, transparent 52%),
        linear-gradient(180deg, transparent 62%, rgb(3 15 30 / 0.25) 100%);
    }

    .contact-hero :global(.home-hero__camera) {
      width: 100%;
      height: 100%;
      max-width: min(58vw, 46rem);
      aspect-ratio: auto;
      max-height: none;
      object-fit: cover;
      object-position: 46% center;
      border-radius: 0;
      transform: none !important;
      min-width: min(50vw, 38rem) !important;
      -webkit-mask-image:
        linear-gradient(90deg, transparent 0%, transparent 2%, rgb(0 0 0 / 0.3) 12%, #000 30%, #000 86%, transparent 100%),
        radial-gradient(ellipse 96% 92% at 58% 50%, #000 36%, transparent 100%) !important;
      mask-image:
        linear-gradient(90deg, transparent 0%, transparent 2%, rgb(0 0 0 / 0.3) 12%, #000 30%, #000 86%, transparent 100%),
        radial-gradient(ellipse 96% 92% at 58% 50%, #000 36%, transparent 100%) !important;
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
    }
  }

  @media (max-width: 768px) {
    .contact-hero :global(.home-hero__visual) {
      min-height: auto;
      border-radius: 1rem;
    }

    .contact-hero :global(.home-hero__visual)::after {
      background:
        linear-gradient(180deg, transparent 52%, rgb(3 15 30 / 0.45) 78%, rgb(3 15 30 / 0.85) 100%);
    }

    .contact-hero :global(.home-hero__camera) {
      width: 100% !important;
      max-width: 100% !important;
      margin-left: 0 !important;
      object-position: center 42%;
    }
  }
</style>
