---
interface Props {
  items: readonly string[];
}

const { items } = Astro.props;
---

<section class="border-y border-section py-section-sm">
  <div class="container">
    <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
      {items.map((item) => (
        <li class="flex items-center gap-2 text-fg-soft">
          <span class="text-accent" aria-hidden="true">✦</span>
          {item}
        </li>
      ))}
    </ul>
  </div>
</section>
