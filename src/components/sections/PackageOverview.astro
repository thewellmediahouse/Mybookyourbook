---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import PackageTierCard from '@/components/marketing/PackageTierCard.astro';
import type { ServicePackages } from '@/config/packages';
import {
  buildPackageAccentStyleAttribute,
  isRecommendedTier,
} from '@/utils/packageAccent';

interface Props {
  heading?: string;
  groups: ServicePackages[];
}

const { heading = 'Package overview', groups } = Astro.props;
---

<section class="py-section-sm">
  <div class="container space-y-10">
    <SectionHeading heading={heading} />
    {
      groups.map((group) => (
        <div class="package-tier-group" style={buildPackageAccentStyleAttribute(group.accent)}>
          <h3 class="text-h3 font-semibold text-fg">{group.serviceName}</h3>
          <div class="mt-6 grid gap-6 lg:grid-cols-3">
            {group.tiers.map((tier) => (
              <PackageTierCard
                tier={tier}
                featured={isRecommendedTier(group.recommendedTierId, tier.id)}
              />
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
