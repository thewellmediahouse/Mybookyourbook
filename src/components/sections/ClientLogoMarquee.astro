---
/**
 * ClientLogoMarquee — premium horizontally scrolling client logo strip.
 * Placement: directly below ClientShowcase on the homepage.
 * Edit logos in src/config/content.ts → home.clientLogoMarquee
 */
import type { ImageMetadata } from 'astro';
import type { ClientLogoMarqueeItem } from '@/config/content';
import OptimizedImage from '@/components/ui/OptimizedImage.astro';

interface Props {
  logos: ClientLogoMarqueeItem[];
}

const { logos } = Astro.props;
const repeatedLogos = [...logos, ...logos];

function isImageMetadata(value: unknown): value is ImageMetadata {
  return typeof value === 'object' && value !== null && 'src' in value && 'width' in value && 'height' in value;
}
---

<section class="client-logo-marquee" aria-label="Client brands we have worked with">
  <div class="client-logo-marquee__viewport">
    <ul class="client-logo-marquee__track">
      {
        repeatedLogos.map((logo) => (
          <li class="client-logo-marquee__item">
            {
              isImageMetadata(logo.src) ? (
                <OptimizedImage
                  src={logo.src}
                  alt={logo.alt}
                  width={320}
                  height={320}
                  widths={[200, 320, 560]}
                  sizes="(max-width: 768px) 200px, 280px"
                  fit="contain"
                  loading="lazy"
                />
              ) : (
                <img
                  src={logo.src}
                  alt={logo.alt}
                  width="320"
                  height="320"
                  loading="lazy"
                  decoding="async"
                />
              )
            }
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .client-logo-marquee {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 42px 0;
    background: linear-gradient(180deg, #020b16 0%, #06111f 50%, #020b16 100%);
    border-top: 1px solid rgb(212 175 55 / 0.55);
    border-bottom: 1px solid rgb(212 175 55 / 0.55);
  }

  .client-logo-marquee::before,
  .client-logo-marquee::after {
    content: '';
    position: absolute;
    top: 0;
    width: 180px;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  .client-logo-marquee::before {
    left: 0;
    background: linear-gradient(90deg, #020b16 0%, transparent 100%);
  }

  .client-logo-marquee::after {
    right: 0;
    background: linear-gradient(270deg, #020b16 0%, transparent 100%);
  }

  .client-logo-marquee__viewport {
    overflow: hidden;
  }

  .client-logo-marquee__track {
    display: flex;
    align-items: center;
    width: max-content;
    gap: 88px;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: client-logo-scroll 55s linear infinite;
  }

  /* Pause when off-screen (set by IntersectionObserver) — avoids scroll jank below fold */
  .client-logo-marquee:not(.is-inview) .client-logo-marquee__track,
  .client-logo-marquee:hover .client-logo-marquee__track {
    animation-play-state: paused;
  }

  .client-logo-marquee__item {
    flex: 0 0 auto;
    width: 280px;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 1.25rem;
    overflow: hidden;
    background: #000;
    /* Keep mix-blend inside the card, not against the scrolling page */
    isolation: isolate;
    contain: layout paint;
  }

  .client-logo-marquee__item :global(img) {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: 1.25rem;
    mix-blend-mode: lighten;
  }

  @keyframes client-logo-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 768px) {
    .client-logo-marquee {
      padding: 32px 0;
    }

    .client-logo-marquee__track {
      gap: 56px;
      animation-duration: 38s;
    }

    .client-logo-marquee__item {
      width: 200px;
      height: 115px;
    }

    .client-logo-marquee::before,
    .client-logo-marquee::after {
      width: 80px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .client-logo-marquee__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
      width: 100%;
      max-width: 72rem;
      margin-inline: auto;
      gap: 2rem 3rem;
      padding-inline: 1rem;
    }

    .client-logo-marquee__viewport {
      overflow: visible;
    }
  }
</style>

<script>
  function initClientLogoMarquee() {
    const section = document.querySelector<HTMLElement>('.client-logo-marquee');
    if (!section || section.dataset.marqueeInitialized === 'true') return;
    section.dataset.marqueeInitialized = 'true';

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          section.classList.toggle('is-inview', entry.isIntersecting);
        });
      },
      { rootMargin: '80px 0px', threshold: 0 },
    );

    observer.observe(section);
    document.addEventListener(
      'astro:before-swap',
      () => {
        observer.disconnect();
        delete section.dataset.marqueeInitialized;
      },
      { once: true },
    );
  }

  initClientLogoMarquee();
  document.addEventListener('astro:page-load', initClientLogoMarquee);
</script>
