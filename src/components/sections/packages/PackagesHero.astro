---
import type { ImageMetadata } from 'astro';
import { raster } from '@/assets/raster';
import OptimizedImage from '@/components/ui/OptimizedImage.astro';
import HeroGoldDustOverlay from '@/components/decor/HeroGoldDustOverlay.astro';
import PricingGrowthPathCard from '@/components/sections/packages/PricingGrowthPathCard.astro';

interface GrowthPathStep {
  title: string;
  detail?: string;
  price?: string;
  highlight?: boolean;
}

interface Props {
  eyebrow: string;
  headline: string[];
  support: string;
  chips: string[];
  primaryCta: { label: string; href: string };
  secondaryCta: { label: string; href: string };
  growthPathCard: {
    title: string;
    steps: GrowthPathStep[];
    retainerLabel: string;
    retainers: string[];
  };
  /** Optional hero photo — defaults to the business pricing interview image */
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  class?: string;
}

const {
  eyebrow,
  headline,
  support,
  chips,
  primaryCta,
  secondaryCta,
  growthPathCard,
  heroImage = raster.packages.pricingHeroInterview,
  heroImageAlt = '',
  class: className = '',
} = Astro.props;

const chipIcons = [
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9h4M7 13h10"/></svg>`,
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 18V6"/><path d="M4 18h16"/><path d="M8 18v-5M12 18V8M16 18v-3"/></svg>`,
];
---

<section class:list={['packages-section', 'packages-hero', className]} aria-labelledby="packages-hero-heading">
  <div class="packages-hero__shield" aria-hidden="true"></div>

  <div class="packages-hero__image-layer" aria-hidden="true">
    <OptimizedImage
      class="packages-hero__photo"
      src={heroImage}
      alt={heroImageAlt}
      width={1440}
      height={1800}
      widths={[800, 1080, 1440]}
      sizes="(max-width: 1024px) 100vw, 56vw"
      mobileWidths={[480, 720]}
      mobileSizes="100vw"
      quality={72}
      loading="eager"
      fetchpriority="high"
    />
    <div class="packages-hero__blend packages-hero__blend--left"></div>
    <div class="packages-hero__blend packages-hero__blend--right"></div>
    <div class="packages-hero__blend packages-hero__blend--bottom"></div>
    <div class="packages-hero__blend packages-hero__blend--top"></div>
    <div class="packages-hero__blend packages-hero__blend--vignette"></div>
  </div>

  <div class="container packages-hero__inner">
    <div class="packages-hero__copy scroll-reveal">
      <p class="packages-eyebrow">{eyebrow}</p>
      <h1 id="packages-hero-heading" class="packages-hero__heading">
        {headline[0]}
        <span class="packages-hero__heading-accent">{headline[1]}</span>
        {headline[2]}
      </h1>
      <p class="packages-hero__support">{support}</p>

      <ul class="packages-hero__benefits" aria-label="Key benefits">
        {
          chips.map((chip, index) => (
            <li>
              <span class="packages-hero__benefit-icon" set:html={chipIcons[index] ?? chipIcons[0]} />
              {chip}
            </li>
          ))
        }
      </ul>

      <div class="packages-hero__actions">
        <a href={primaryCta.href} class="packages-btn packages-btn--gold">
          {primaryCta.label}
          <span class="packages-btn__arrow" aria-hidden="true">→</span>
        </a>
        <a href={secondaryCta.href} class="packages-btn packages-btn--outline">
          {secondaryCta.label}
        </a>
      </div>
    </div>

    <PricingGrowthPathCard
      class="packages-hero__growth-path"
      variant="hero"
      title={growthPathCard.title}
      steps={growthPathCard.steps}
      retainerLabel={growthPathCard.retainerLabel}
      retainers={growthPathCard.retainers}
    />
  </div>

  <HeroGoldDustOverlay class="packages-hero__dust" />
</section>

<style>
  .packages-hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(28rem, 88vh, 52rem);
    padding-block: clamp(2.5rem, 6vw, 4rem);
    isolation: isolate;
  }

  .packages-hero :global(.packages-hero__dust) {
    z-index: 15;
  }

  .packages-hero__shield,
  .packages-hero__image-layer {
    display: none;
  }

  .packages-hero__image-layer {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .packages-hero__photo,
  .packages-hero :global(.packages-hero__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% center;
    transform: scale(1.06);
  }

  @media (min-width: 1024px) {
    .packages-hero__shield {
      display: block;
      position: absolute;
      inset: 0 auto 0 0;
      width: 48%;
      z-index: 1;
      background: #020817;
      pointer-events: none;
    }

    .packages-hero__shield::after {
      content: '';
      position: absolute;
      inset: 0 auto 0 100%;
      width: 8rem;
      margin-left: -1px;
      background: linear-gradient(to right, #020817 0%, rgb(2 8 23 / 0.85) 35%, transparent 100%);
    }

    .packages-hero__image-layer {
      left: 44%;
    }

    .packages-hero__photo,
    .packages-hero :global(.packages-hero__photo) {
      top: -8%;
      right: -12%;
      bottom: -8%;
      left: 0;
      width: 100%;
      height: 116%;
      object-position: 52% 42%;
      transform: scale(1.08);
      transform-origin: 55% center;
    }
  }

  .packages-hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    gap: clamp(2rem, 5vw, 2.5rem);
    align-items: center;
    min-height: clamp(22rem, 75vh, 44rem);
  }

  @media (min-width: 1024px) {
    .packages-hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 32rem);
      justify-content: space-between;
      align-items: center;
    }
  }

  .packages-hero__copy {
    position: relative;
    z-index: 3;
  }

  @media (min-width: 1024px) {
    .packages-hero__copy {
      max-width: 38rem;
      padding-right: 1rem;
    }
  }

  .packages-hero :global(.packages-hero__growth-path) {
    position: relative;
    z-index: 4;
    width: 100%;
    max-width: min(100%, 28rem);
    margin-inline: auto;
  }

  @media (min-width: 1024px) {
    .packages-hero :global(.packages-hero__growth-path) {
      max-width: 32rem;
      margin-inline: 0 0;
      margin-left: auto;
    }
  }

  .packages-hero__heading {
    margin: 0.75rem 0 1rem;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }

  .packages-hero__heading-accent {
    display: block;
    color: #f0c96f;
  }

  .packages-hero__support {
    max-width: 38rem;
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.65;
    color: #b8c0d0;
  }

  .packages-hero__benefits {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .packages-hero__benefits li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: #f6f2eb;
  }

  .packages-hero__benefit-icon {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    border: 1px solid rgb(214 169 74 / 0.4);
    background: rgb(214 169 74 / 0.08);
    color: #f0c96f;
  }

  .packages-hero__benefit-icon :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
  }

  .packages-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2rem;
  }

  .packages-hero__blend {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .packages-hero__blend--left {
    background: linear-gradient(
      to right,
      #020817 0%,
      rgb(2 8 23 / 0.92) 35%,
      rgb(2 8 23 / 0.55) 55%,
      transparent 75%
    );
  }

  @media (min-width: 1024px) {
    .packages-hero__blend--left {
      background: linear-gradient(
        to right,
        rgb(2 8 23 / 0.95) 0%,
        rgb(2 8 23 / 0.5) 10%,
        rgb(2 8 23 / 0.15) 22%,
        transparent 38%
      );
    }
  }

  .packages-hero__blend--right {
    background: linear-gradient(
      to left,
      #020817 0%,
      rgb(2 8 23 / 0.75) 8%,
      rgb(2 8 23 / 0.25) 18%,
      transparent 32%
    );
  }

  .packages-hero__blend--bottom {
    background: linear-gradient(
      to top,
      #020817 0%,
      rgb(2 8 23 / 0.95) 10%,
      rgb(2 8 23 / 0.55) 22%,
      transparent 42%
    );
  }

  .packages-hero__blend--top {
    background: linear-gradient(
      to bottom,
      #020817 0%,
      rgb(2 8 23 / 0.9) 12%,
      rgb(2 8 23 / 0.4) 26%,
      transparent 42%
    );
  }

  .packages-hero__blend--vignette {
    background: radial-gradient(
      ellipse 95% 88% at 62% 48%,
      transparent 22%,
      rgb(2 8 23 / 0.25) 62%,
      rgb(2 8 23 / 0.55) 100%
    );
  }
</style>
