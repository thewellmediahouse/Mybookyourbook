---
import { raster } from '@/assets/raster';
import OptimizedImage from '@/components/ui/OptimizedImage.astro';

interface LogicCard {
  title: string;
  description: string;
}

interface Props {
  heading: string;
  intro: string;
  cards: LogicCard[];
  class?: string;
}

const { heading, intro, cards, class: className = '' } = Astro.props;
---

<section class:list={['packages-section', 'packages-pricing-logic', className]} aria-labelledby="pricing-logic-heading">
  <div class="container">
    <div class="packages-pricing-logic__layout scroll-reveal">
      <div class="packages-pricing-logic__intro">
        <h2 id="pricing-logic-heading" class="packages-pricing-logic__heading">{heading}</h2>
        <p class="packages-pricing-logic__copy">{intro}</p>
        <OptimizedImage
          class="packages-pricing-logic__visual"
          src={raster.packages.singleServicesVsPackage}
          alt=""
          width={800}
          height={600}
          widths={[400, 640, 800]}
          sizes="(max-width: 768px) 100vw, 40vw"
          loading="lazy"
        />
      </div>

      <ol class="packages-pricing-logic__grid">
        {
          cards.map((card, index) => (
            <li class="packages-pricing-logic__card scroll-reveal" style={`--reveal-delay: ${index * 80}ms`}>
              <span class="packages-pricing-logic__number">{index + 1}</span>
              <h3 class="packages-pricing-logic__card-title">{card.title}</h3>
              <p class="packages-pricing-logic__card-text">{card.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .packages-pricing-logic__layout {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 1024px) {
    .packages-pricing-logic__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      align-items: start;
    }
  }

  .packages-pricing-logic__heading {
    margin: 0 0 1rem;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1.1;
  }

  .packages-pricing-logic__copy {
    margin: 0 0 1.5rem;
    max-width: 38rem;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: #c8cfdd;
  }

  .packages-pricing-logic__visual,
  .packages-pricing-logic :global(.packages-pricing-logic__visual) {
    width: 100%;
    max-width: 28rem;
    display: block;
    border-radius: 1rem;
    border: 1px solid rgb(214 169 74 / 0.22);
    opacity: 0.92;
  }

  .packages-pricing-logic__grid {
    display: grid;
    gap: 0.875rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .packages-pricing-logic__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .packages-pricing-logic__card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-height: 100%;
    padding: 1.125rem 1.25rem;
    border-radius: 1rem;
    border: 1px solid rgb(214 169 74 / 0.24);
    background: rgb(6 14 28 / 0.88);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
  }

  .packages-pricing-logic__card:hover {
    transform: translateY(-4px);
    border-color: rgb(214 169 74 / 0.42);
    box-shadow: 0 16px 36px rgb(0 0 0 / 0.32);
  }

  .packages-pricing-logic__number {
    width: 1.75rem;
    height: 1.75rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 1px solid rgb(214 169 74 / 0.4);
    font-size: 0.75rem;
    font-weight: 700;
    color: #f0c96f;
  }

  .packages-pricing-logic__card-title {
    margin: 0.25rem 0 0;
    font-size: 1rem;
    font-family: var(--font-sans);
    font-weight: 700;
    color: #f6f2eb;
  }

  .packages-pricing-logic__card-text {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: #c8cfdd;
  }
</style>
