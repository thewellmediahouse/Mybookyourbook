---
import { raster } from '@/assets/raster';
import OptimizedImage from '@/components/ui/OptimizedImage.astro';

interface ServiceCard {
  title: string;
  imageKey: 'videoProduction' | 'productPhotography' | 'socialContent' | 'strategyGrowth';
}

interface Props {
  items: ServiceCard[];
}

const { items } = Astro.props;
---

<section class="packages-section packages-visual-services" aria-label="Core services">
  <div class="container">
    <div class="packages-visual-services__grid">
      {
        items.map((item) => (
          <article class="packages-visual-card scroll-reveal">
            <OptimizedImage
              src={raster.packages[item.imageKey]}
              alt=""
              width={1200}
              height={900}
              widths={[400, 640, 960, 1200]}
              sizes="(max-width: 640px) 100vw, 50vw"
              loading="lazy"
            />
            <div class="packages-visual-card__overlay" aria-hidden="true"></div>
            <h2 class="packages-visual-card__title">{item.title}</h2>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .packages-visual-services__grid {
    display: grid;
    gap: 1.125rem;
  }

  @media (min-width: 640px) {
    .packages-visual-services__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  .packages-visual-card {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 1.25rem;
    border: 1px solid rgb(214 169 74 / 0.32);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .packages-visual-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.35), 0 0 24px rgb(214 169 74 / 0.12);
  }

  .packages-visual-card :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .packages-visual-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(6 17 31 / 0.05) 30%, rgb(6 17 31 / 0.92) 100%);
  }

  .packages-visual-card__title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 1.25rem 1.125rem;
    font-size: 1rem;
    font-family: var(--font-sans);
    font-weight: 700;
    color: #f0c96f;
    z-index: 1;
  }
</style>
