---
/**
 * Full-bleed statement band — one centered line on a dark brand surface.
 */
interface Props {
  statement: string;
  class?: string;
}

const { statement, class: className = '' } = Astro.props;
---

{
  statement && (
    <div class:list={['band-dark bg-[var(--brand-primary)] py-6 md:py-8', className]}>
      <p class="container text-center text-xs font-semibold uppercase tracking-[0.22em] text-fg md:text-sm">
        {statement}
      </p>
    </div>
  )
}
