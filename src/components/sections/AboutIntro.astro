---
import Container from '@/components/ui/Container.astro';
import ConfigImage from '@/components/ui/ConfigImage.astro';

interface Props {
  heading: string;
  /** Line under the heading, e.g. role title. */
  role?: string;
  /** Line under the role, e.g. credentials. */
  credentials?: string;
  /** Single paragraph. Ignored when `paragraphs` is provided. */
  paragraph?: string;
  /** Multi-paragraph body. Supports `**bold**` markers. */
  paragraphs?: readonly string[];
  image?: {
    src: string;
    alt: string;
    width?: number;
    height?: number;
  };
}

const { heading, role, credentials, paragraph, paragraphs, image } = Astro.props;

const body = paragraphs?.length ? [...paragraphs] : paragraph ? [paragraph] : [];

function renderInline(text: string) {
  return text.split(/(\*\*[^*]+\*\*)/g).map((part) => {
    if (part.startsWith('**') && part.endsWith('**')) {
      return { type: 'strong' as const, text: part.slice(2, -2) };
    }
    return { type: 'text' as const, text: part };
  });
}

const hasImage = Boolean(image?.src);
const imageWidth = image?.width ?? 720;
const imageHeight = image?.height ?? 900;
---

<section class="py-section-sm">
  <Container size={hasImage ? 'wide' : 'narrow'}>
    <div class:list={['gap-10', hasImage && 'grid items-start lg:grid-cols-2']}>
      {
        image && (
          <div class="mx-auto w-full max-w-md lg:mx-0 lg:max-w-none">
            <ConfigImage
              src={image.src}
              alt={image.alt}
              width={imageWidth}
              height={imageHeight}
              widths={[400, 560, 720, imageWidth]}
              sizes="(max-width: 1024px) min(100vw, 28rem), min(42vw, 34rem)"
              class="aspect-[4/5] w-full object-cover"
              loading="lazy"
            />
          </div>
        )
      }

      <div>
        <h2 class="text-h2 font-bold text-fg">{heading}</h2>
        {role && <p class="mt-2 text-lg font-medium text-accent">{role}</p>}
        {credentials && <p class="mt-1 text-small tracking-wide text-fg-muted">{credentials}</p>}
        <div class="mt-4 space-y-5 text-lg leading-relaxed text-fg-soft">
          {
            body.map((text) => (
              <p>
                {renderInline(text).map((part) =>
                  part.type === 'strong' ? (
                    <strong class="font-semibold text-fg">{part.text}</strong>
                  ) : (
                    part.text
                  ),
                )}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </Container>
</section>
