---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { AlaCarteItem } from '@/config/packages';

interface Props {
  heading?: string;
  subheading?: string;
  items: AlaCarteItem[];
}

const {
  heading = 'Individual / À La Carte Items',
  subheading,
  items,
} = Astro.props;
---

<section class="py-section-sm">
  <div class="container space-y-8">
    <SectionHeading heading={heading} subheading={subheading} />
    <div class="surface-card divide-y divide-white/10">
      {
        items.map((entry) => (
          <div class="flex flex-col gap-1 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
            <span class="text-fg-soft">{entry.item}</span>
            <span class="shrink-0 font-semibold text-accent">{entry.price}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
