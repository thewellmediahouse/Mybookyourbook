---
import type { ImageMetadata } from 'astro';
import type { ClientShowcaseCard } from '@/config/content';
import ClientShowcaseGraphBg from '@/components/decor/ClientShowcaseGraphBg.astro';
import OptimizedImage from '@/components/ui/OptimizedImage.astro';
import {
  getYoutubeHoverEmbedUrl,
  getYoutubeModalEmbedUrl,
  parseVideoUrl,
} from '@/utils/videoEmbed';

interface Props {
  eyebrow: string;
  heading: string;
  headingHighlight?: string;
  subheading: string;
  items: ClientShowcaseCard[];
}

const { eyebrow, heading, headingHighlight, subheading, items } = Astro.props;

function isImageMetadata(value: unknown): value is ImageMetadata {
  return typeof value === 'object' && value !== null && 'src' in value && 'width' in value && 'height' in value;
}

const cards = items.map((item) => {
  const parsed = item.videoUrl ? parseVideoUrl(item.videoUrl) : null;
  return {
    ...item,
    imageMeta: isImageMetadata(item.image) ? item.image : null,
    youtubeId: parsed?.id,
    embedUrl: parsed ? getYoutubeHoverEmbedUrl(parsed.id) : undefined,
    modalEmbedUrl: parsed ? getYoutubeModalEmbedUrl(parsed.id) : undefined,
  };
});
---

<section class="client-showcase" aria-labelledby="client-showcase-heading">
  <div class="client-showcase__inner">
    <header class="client-showcase__header scroll-reveal">
      <p class="client-showcase__eyebrow">{eyebrow}</p>
      <h2 id="client-showcase-heading" class="client-showcase__heading">
        {heading}
        {
          headingHighlight && (
            <>
              {' '}
              <span class="client-showcase__heading-accent">{headingHighlight}</span>
            </>
          )
        }
      </h2>
      <p class="client-showcase__subheading">{subheading}</p>
    </header>

    <div class="client-showcase__panel scroll-reveal">
      <ClientShowcaseGraphBg />

      <ul class="client-showcase__grid">
        {
          cards.map((item, index) => (
            <li
              class:list={[
                'client-showcase__card',
                item.youtubeId && 'client-showcase__card--video',
                item.graphAnimation && 'client-showcase__card--graph',
              ]}
              style={`--reveal-delay: ${index * 70}ms`}
              data-showcase-video={item.youtubeId ? '' : undefined}
              data-embed-url={item.embedUrl}
              data-modal-embed-url={item.modalEmbedUrl}
              data-video-title={item.youtubeId ? item.imageAlt : undefined}
              data-showcase-graph={item.graphAnimation ? '' : undefined}
            >
              <article class="client-showcase__card-frame">
                {
                  item.imageMeta ? (
                    <OptimizedImage
                      src={item.imageMeta}
                      alt={item.imageAlt}
                      width={item.width}
                      height={item.height}
                      widths={[320, 480, 640]}
                      sizes="(max-width: 768px) 85vw, 396px"
                      class="client-showcase__image"
                      loading="lazy"
                    />
                  ) : (
                    <img
                      src={typeof item.image === 'string' ? item.image : ''}
                      alt={item.imageAlt}
                      width={item.width}
                      height={item.height}
                      class="client-showcase__image"
                      loading="lazy"
                      decoding="async"
                    />
                  )
                }

                {
                  item.youtubeId && (
                    <>
                      <div class="client-showcase__video-slot" data-video-slot aria-hidden="true" />
                      <button
                        type="button"
                        class="client-showcase__video-open"
                        data-video-open
                        aria-label={`Open video with sound: ${item.imageAlt}`}
                      >
                        <span class="client-showcase__play-mobile" aria-hidden="true">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M8 5v14l11-7z" />
                          </svg>
                        </span>
                      </button>
                    </>
                  )
                }

                {
                  item.graphAnimation && (
                    <div class="client-showcase__graph" aria-hidden="true">
                      <svg
                        class="client-showcase__graph-svg"
                        viewBox="0 0 320 140"
                        preserveAspectRatio="none"
                      >
                        <defs>
                          <linearGradient id="showcase-graph-stroke" x1="0%" y1="100%" x2="100%" y2="0%">
                            <stop offset="0%" stop-color="rgb(214 165 79 / 0.2)" />
                            <stop offset="40%" stop-color="rgb(242 199 107 / 0.95)" />
                            <stop offset="100%" stop-color="rgb(255 236 170 / 1)" />
                          </linearGradient>
                          <linearGradient id="showcase-graph-fill" x1="0%" y1="0%" x2="0%" y2="100%">
                            <stop offset="0%" stop-color="rgb(214 165 79 / 0.35)" />
                            <stop offset="100%" stop-color="rgb(214 165 79 / 0)" />
                          </linearGradient>
                          <filter id="showcase-graph-glow" x="-20%" y="-20%" width="140%" height="140%">
                            <feGaussianBlur stdDeviation="2.5" result="blur" />
                            <feMerge>
                              <feMergeNode in="blur" />
                              <feMergeNode in="SourceGraphic" />
                            </feMerge>
                          </filter>
                        </defs>
                        <path
                          class="client-showcase__graph-area"
                          d="M 8 118 L 8 96 L 48 88 L 92 72 L 136 54 L 180 36 L 224 22 L 268 12 L 312 6 L 312 118 Z"
                        />
                        <path
                          class="client-showcase__graph-line"
                          d="M 8 96 L 48 88 L 92 72 L 136 54 L 180 36 L 224 22 L 268 12 L 312 6"
                          pathLength="100"
                        />
                      </svg>
                      <div class="client-showcase__graph-glow" />
                    </div>
                  )
                }
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div
    class="client-showcase-modal"
    data-showcase-modal
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="client-showcase-modal-title"
  >
    <button type="button" class="client-showcase-modal__backdrop" data-modal-close aria-label="Close video" />
    <div class="client-showcase-modal__dialog">
      <div class="client-showcase-modal__header">
        <h3 id="client-showcase-modal-title" class="client-showcase-modal__title" data-modal-title>
          Client video
        </h3>
        <button type="button" class="client-showcase-modal__close" data-modal-close aria-label="Close video">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6L6 18M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="client-showcase-modal__frame" data-modal-frame />
    </div>
  </div>
</section>

<style>
  .client-showcase {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(3.375rem, 7vw, 4.5rem) clamp(1rem, 3vw, 1.5rem)
      clamp(4rem, 8vw, 5.5rem);
    background:
      radial-gradient(circle at 50% 0%, rgb(214 168 79 / 0.1) 0%, transparent 34%),
      linear-gradient(180deg, #030a14 0%, #071322 100%);
  }

  .client-showcase__inner {
    position: relative;
    z-index: 1;
    max-width: 92.5rem;
    margin-inline: auto;
  }

  .client-showcase__header {
    position: relative;
    z-index: 2;
    max-width: 52rem;
    margin-inline: auto;
    margin-bottom: 2.125rem;
    text-align: center;
  }

  .client-showcase__eyebrow {
    margin: 0 0 1rem;
    font-size: clamp(0.6875rem, 1vw, 0.8125rem);
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #d6a84f;
  }

  .client-showcase__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #f8fafc;
  }

  .client-showcase__heading-accent {
    color: #f2c76b;
  }

  .client-showcase__subheading {
    margin: 1.25rem auto 0;
    max-width: 42rem;
    font-size: clamp(1rem, 1.8vw, 1.125rem);
    line-height: 1.65;
    color: #b8c0cc;
  }

  .client-showcase__panel {
    position: relative;
    overflow: hidden;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    border-radius: 1.75rem;
    border: 1px solid rgb(212 165 76 / 0.22);
    background:
      linear-gradient(180deg, rgb(7 19 34 / 0.94) 0%, rgb(3 10 20 / 0.98) 100%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.04),
      0 28px 90px rgb(0 0 0 / 0.38);
  }

  .client-showcase__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: start;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .client-showcase__card-frame {
    position: relative;
    overflow: visible;
    border-radius: 1.5rem;
  }

  :global(.client-showcase__image) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 1.5rem;
  }

  .client-showcase__video-slot {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 58%;
    overflow: hidden;
    border-radius: 1.25rem 1.25rem 0 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.45s ease;
    z-index: 2;
  }

  .client-showcase__video-slot :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    pointer-events: none;
  }

  .client-showcase__card--video.is-previewing .client-showcase__video-slot {
    opacity: 1;
  }

  .client-showcase__video-open {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 58%;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .client-showcase__video-open .client-showcase__play-mobile {
    display: none;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, #ffd977, #e0a938 55%, #9c6818);
    color: #06111f;
    box-shadow: 0 10px 28px rgb(224 169 56 / 0.35);
  }

  .client-showcase__video-open .client-showcase__play-mobile svg {
    width: 1.125rem;
    height: 1.125rem;
    translate: 1px 0;
  }

  @media (max-width: 768px) {
    .client-showcase__video-open .client-showcase__play-mobile {
      display: inline-flex;
    }
  }

  .client-showcase__graph {
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 28%;
    height: 32%;
    pointer-events: none;
    z-index: 3;
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .client-showcase__graph-svg {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: url(#showcase-graph-glow);
  }

  .client-showcase__graph-area {
    fill: url(#showcase-graph-fill);
    opacity: 0;
    transition: opacity 1s ease 0.3s;
  }

  .client-showcase__graph-line {
    fill: none;
    stroke: url(#showcase-graph-stroke);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    transition: stroke-dashoffset 1.8s cubic-bezier(0.33, 1, 0.68, 1);
  }

  .client-showcase__graph-glow {
    position: absolute;
    inset: 20% 10% 0;
    background: radial-gradient(ellipse at 50% 100%, rgb(242 199 107 / 0.35) 0%, transparent 72%);
    opacity: 0;
    transition: opacity 1.2s ease 0.4s;
    z-index: 1;
  }

  .client-showcase__card--graph.is-graph-active .client-showcase__graph {
    opacity: 1;
  }

  .client-showcase__card--graph.is-graph-active .client-showcase__graph-line {
    stroke-dashoffset: 0;
  }

  .client-showcase__card--graph.is-graph-active .client-showcase__graph-area {
    opacity: 0.55;
  }

  .client-showcase__card--graph.is-graph-active .client-showcase__graph-glow {
    opacity: 1;
  }

  @media (max-width: 1024px) {
    .client-showcase__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .client-showcase__card:nth-child(3) {
      grid-column: 1 / -1;
      max-width: 45rem;
      margin-inline: auto;
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .client-showcase {
      padding: 3.375rem 1rem 4rem;
    }

    .client-showcase__panel {
      padding: 1rem;
    }

    .client-showcase__grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .client-showcase__card:nth-child(3) {
      max-width: none;
    }

    .client-showcase__card--graph.is-graph-active .client-showcase__graph-line {
      animation: showcase-graph-pulse 2.8s ease-in-out infinite;
    }

    .client-showcase__card--graph.is-graph-active .client-showcase__graph-glow {
      animation: showcase-glow-pulse 2.8s ease-in-out infinite;
    }
  }

  @keyframes showcase-graph-pulse {
    0%,
    100% {
      stroke-dashoffset: 18;
      opacity: 0.85;
    }
    50% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @keyframes showcase-glow-pulse {
    0%,
    100% {
      opacity: 0.45;
    }
    50% {
      opacity: 0.95;
    }
  }

  .client-showcase-modal[hidden] {
    display: none;
  }

  .client-showcase-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 1rem;
  }

  .client-showcase-modal__backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: rgb(2 8 16 / 0.88);
    backdrop-filter: blur(8px);
    cursor: pointer;
  }

  .client-showcase-modal__dialog {
    position: relative;
    z-index: 1;
    width: min(100%, 56rem);
    border-radius: 1.25rem;
    border: 1px solid rgb(212 165 76 / 0.35);
    background: linear-gradient(180deg, #071322 0%, #030a14 100%);
    box-shadow:
      0 32px 100px rgb(0 0 0 / 0.55),
      0 0 60px rgb(214 165 79 / 0.12);
    overflow: hidden;
  }

  .client-showcase-modal__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgb(212 165 76 / 0.18);
  }

  .client-showcase-modal__title {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    color: #f8fafc;
    text-wrap: balance;
  }

  .client-showcase-modal__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    border: 1px solid rgb(212 165 76 / 0.3);
    border-radius: 9999px;
    background: rgb(214 165 79 / 0.08);
    color: #f2c76b;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .client-showcase-modal__close:hover {
    background: rgb(214 165 79 / 0.16);
    border-color: rgb(242 199 107 / 0.45);
  }

  .client-showcase-modal__close svg {
    width: 1rem;
    height: 1rem;
  }

  .client-showcase-modal__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  .client-showcase-modal__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .client-showcase__graph-line,
    .client-showcase__graph-area,
    .client-showcase__graph-glow,
    .client-showcase__video-slot {
      transition: none;
      animation: none !important;
    }

    .client-showcase__card--graph.is-graph-active .client-showcase__graph-line {
      stroke-dashoffset: 0;
    }

    .client-showcase__card--graph.is-graph-active .client-showcase__graph {
      opacity: 1;
    }
  }
</style>

<script>
  function initClientShowcase() {
    const mobileQuery = window.matchMedia('(max-width: 768px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const modal = document.querySelector<HTMLElement>('[data-showcase-modal]');
    const modalFrame = document.querySelector<HTMLElement>('[data-modal-frame]');
    const modalTitle = document.querySelector<HTMLElement>('[data-modal-title]');
    let lastFocused: HTMLElement | null = null;

    function openModal(embedUrl: string, title: string) {
      if (!modal || !modalFrame) return;

      lastFocused = document.activeElement as HTMLElement | null;
      modalTitle && (modalTitle.textContent = title);
      modal.hidden = false;
      modal.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';

      modalFrame.innerHTML = '';
      const iframe = document.createElement('iframe');
      iframe.src = embedUrl;
      iframe.title = title;
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      modalFrame.appendChild(iframe);

      modal.querySelector<HTMLButtonElement>('.client-showcase-modal__close')?.focus();
    }

    function closeModal() {
      if (!modal || !modalFrame) return;

      modal.hidden = true;
      modal.setAttribute('hidden', '');
      document.body.style.overflow = '';
      modalFrame.innerHTML = '';
      lastFocused?.focus();
      lastFocused = null;
    }

    if (modal && modal.dataset.modalInitialized !== 'true') {
      modal.dataset.modalInitialized = 'true';

      modal.querySelectorAll('[data-modal-close]').forEach((el) => {
        el.addEventListener('click', closeModal);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && modal && !modal.hidden) closeModal();
      });
    }

    document.querySelectorAll<HTMLElement>('[data-showcase-video]').forEach((card) => {
      if (card.dataset.videoInitialized === 'true') return;
      card.dataset.videoInitialized = 'true';

      const previewUrl = card.dataset.embedUrl;
      const modalUrl = card.dataset.modalEmbedUrl;
      const title = card.dataset.videoTitle ?? 'Client showcase video';
      const slot = card.querySelector<HTMLElement>('[data-video-slot]');
      const openBtn = card.querySelector<HTMLButtonElement>('[data-video-open]');
      if (!previewUrl || !modalUrl || !slot) return;

      let previewIframe: HTMLIFrameElement | null = null;

      function startPreview() {
        if (previewIframe || mobileQuery.matches) return;
        previewIframe = document.createElement('iframe');
        previewIframe.src = previewUrl;
        previewIframe.title = `${title} preview`;
        previewIframe.allow =
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        previewIframe.tabIndex = -1;
        slot.appendChild(previewIframe);
        card.classList.add('is-previewing');
      }

      function stopPreview() {
        previewIframe?.remove();
        previewIframe = null;
        card.classList.remove('is-previewing');
      }

      openBtn?.addEventListener('click', (event) => {
        event.preventDefault();
        stopPreview();
        openModal(modalUrl, title);
      });

      if (!mobileQuery.matches) {
        card.addEventListener('mouseenter', startPreview);
        card.addEventListener('mouseleave', stopPreview);
      }
    });

    document.querySelectorAll<HTMLElement>('[data-showcase-graph]').forEach((card) => {
      if (card.dataset.graphInitialized === 'true') return;
      card.dataset.graphInitialized = 'true';

      function activate() {
        card.classList.add('is-graph-active');
      }

      function deactivate() {
        if (mobileQuery.matches) return;
        card.classList.remove('is-graph-active');
      }

      if (mobileQuery.matches || reducedMotion) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) activate();
            });
          },
          { threshold: 0.35 },
        );
        observer.observe(card);
        document.addEventListener(
          'astro:before-swap',
          () => observer.disconnect(),
          { once: true },
        );
        return;
      }

      card.addEventListener('mouseenter', activate);
      card.addEventListener('mouseleave', deactivate);
    });
  }

  initClientShowcase();
  document.addEventListener('astro:page-load', initClientShowcase);
</script>
