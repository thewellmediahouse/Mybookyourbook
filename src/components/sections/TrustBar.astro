---
/**
 * Compact trust / proof strip — labels with optional icons on a dark band.
 */
import type { TrustBarItem } from '@/config/content';

interface Props {
  items: TrustBarItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;

const icons: Record<string, string> = {
  star: '<path fill="currentColor" stroke="none" d="M12 3.5l2.47 5.14 5.53.62-4.1 3.86 1.1 5.51L12 15.9l-4.99 2.73 1.1-5.51-4.1-3.86 5.53-.62L12 3.5z" />',
  shield:
    '<path fill="none" stroke="currentColor" stroke-width="1.4" d="M12 3l7 3v5.2c0 4.6-3 8.3-7 9.8-4-1.5-7-5.2-7-9.8V6l7-3z" /><path fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />',
  check:
    '<path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" d="M5 12.5l4 4L19 7" />',
  delivery:
    '<path fill="none" stroke="currentColor" stroke-width="1.4" d="M3 7h11v8H3z" /><path fill="none" stroke="currentColor" stroke-width="1.4" d="M14 10h3.2L20 12.6V15h-6z" /><circle fill="currentColor" stroke="none" cx="7" cy="17.5" r="1.5" /><circle fill="currentColor" stroke="none" cx="17" cy="17.5" r="1.5" />',
};
---

{
  items.length > 0 && (
    <div class:list={['band-dark bg-[var(--brand-primary)] py-2.5', className]}>
      <div class="container flex flex-wrap items-center justify-center gap-x-10 gap-y-1.5 text-center">
        {items.map((item) => (
          <div class="flex items-center gap-2">
            <svg
              viewBox="0 0 24 24"
              class="h-3.5 w-3.5 shrink-0 text-[var(--brand-accent)]"
              aria-hidden="true"
              set:html={icons[item.icon ?? 'star'] ?? icons.star}
            />
            <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-fg sm:text-[11px]">
              {item.label}
            </span>
          </div>
        ))}
      </div>
    </div>
  )
}
