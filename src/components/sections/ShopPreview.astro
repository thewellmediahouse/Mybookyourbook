---
import { shopConfig } from '@/config/shop';
import { getProducts, isShopifyConfigured } from '@/lib/shopify';
import Button from '@/components/ui/Button.astro';
import ConfigImage from '@/components/ui/ConfigImage.astro';
import ProductGrid from '@/components/shop/ProductGrid.astro';
import LiveStockSync from '@/components/shop/LiveStockSync.astro';

const teaser = shopConfig.preview;
const configured = isShopifyConfigured();
const products = configured ? (await getProducts(3)).slice(0, 3) : [];
const hasProducts = products.length > 0;
---

<section class="section-surface py-section">
  <div class="container">
    {
      hasProducts ? (
        <div class="space-y-8">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
            <div class="max-w-2xl space-y-2">
              <span class="inline-flex items-center gap-2 rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary">
                {teaser.eyebrow}
              </span>
              <h2 class="text-h2 font-semibold text-fg">{teaser.heading}</h2>
              <p class="text-fg-muted">{teaser.paragraph}</p>
            </div>
            <a
              href={teaser.viewAll.href}
              class="inline-flex items-center gap-1.5 text-small font-semibold text-primary transition hover:text-accent"
            >
              {teaser.viewAll.label}
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <ProductGrid products={products} compact />
          <LiveStockSync />
        </div>
      ) : (
        <div class="surface-card grid items-center gap-6 overflow-hidden p-6 lg:grid-cols-2 lg:p-8">
          <div class="space-y-4">
            <span class="inline-block rounded-full bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary">
              {teaser.eyebrow}
            </span>
            <h2 class="text-h2 font-semibold text-fg">{teaser.heading}</h2>
            <p class="text-fg-muted">{teaser.paragraph}</p>
            <Button variant="accent" href={teaser.button.href} external={teaser.button.external}>
              {teaser.button.label}
            </Button>
          </div>
          {teaser.image && (
            <div class="flex justify-center">
              <ConfigImage
                src={teaser.image.src}
                alt={teaser.image.alt}
                class="max-h-64 w-full max-w-sm object-contain"
                width={400}
                height={300}
                fit="contain"
                loading="lazy"
              />
            </div>
          )}
        </div>
      )
    }
  </div>
</section>
