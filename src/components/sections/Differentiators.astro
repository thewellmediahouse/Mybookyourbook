---
import type { DifferentiatorCard } from '@/config/content';
import { raster } from '@/assets/raster';
import OptimizedImage from '@/components/ui/OptimizedImage.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  paragraph: string;
  cards: DifferentiatorCard[];
}

const { eyebrow, heading, paragraph, cards } = Astro.props;
---

<section class="differentiators relative overflow-hidden py-section">
  <OptimizedImage
    src={raster.backgrounds.growthPartner}
    alt=""
    width={1920}
    height={1080}
    widths={[640, 960, 1280, 1920]}
    sizes="100vw"
    class="differentiators__image"
    loading="lazy"
  />
  <div class="differentiators__overlay" aria-hidden="true" />
  <div class="container relative z-10">
    <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="scroll-reveal">
        {
          eyebrow && (
            <p class="mb-3 text-small font-semibold uppercase tracking-[0.14em] text-accent">
              {eyebrow}
            </p>
          )
        }
        <h2 class="text-h2 font-bold text-fg">{heading}</h2>
        <p class="mt-5 max-w-xl text-lg text-fg-soft">{paragraph}</p>
      </div>
      <ul class="space-y-4">
        {
          cards.map((card, index) => (
            <li
              class="premium-card differentiator-card scroll-reveal flex gap-4 p-5"
              style={`--reveal-delay: ${index * 80}ms`}
            >
              <span class="differentiator-card__icon shrink-0" aria-hidden="true">◆</span>
              <div>
                <h3 class="text-h4 font-semibold text-fg">{card.title}</h3>
                <p class="mt-1 text-fg-soft">{card.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  :global(.differentiators__image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.18;
    pointer-events: none;
  }

  .differentiators__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(135deg, rgb(3 15 30 / 0.94) 0%, rgb(6 25 46 / 0.9) 100%),
      radial-gradient(ellipse 70% 60% at 80% 50%, rgb(224 169 56 / 0.08) 0%, transparent 60%);
    pointer-events: none;
  }

  .differentiator-card {
    transition:
      transform 0.35s ease,
      border-color 0.35s ease;
  }

  .differentiator-card:hover {
    transform: translateY(-3px);
    border-color: rgb(224 169 56 / 0.35);
  }

  .differentiator-card__icon {
    color: var(--brand-accent, #e0a938);
    margin-top: 0.2rem;
  }
</style>
