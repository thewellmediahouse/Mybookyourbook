---
import { shopConfig } from '@/config/shop';
import { formatMoney, type ProductSummary } from '@/lib/shopify';
import ShopifyImage from '@/components/shop/ShopifyImage.astro';

interface Props {
  product: ProductSummary;
  /** Hide description for compact embeds (e.g. home preview). */
  compact?: boolean;
}

const { product, compact = false } = Astro.props;
const image = product.featuredImage;
const price = formatMoney(product.priceRange.minVariantPrice);
const href = `/shop/${product.handle}/`;
const { labels, availability } = shopConfig;
---

<article
  class="surface-card flex h-full flex-col overflow-hidden transition hover:shadow-elevated"
  data-product-card
  data-product-handle={product.handle}
>
  <a href={href} class="block aspect-[4/3] overflow-hidden bg-black/20">
    {
      image ? (
        <ShopifyImage
          url={image.url}
          alt={image.altText ?? product.title}
          class="h-full w-full object-cover"
          width={image.width ?? 800}
          height={image.height ?? 600}
          widths={[320, 480, 800]}
          sizes="(max-width: 768px) 50vw, 400px"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full items-center justify-center text-small text-fg-muted">{labels.noImage}</div>
      )
    }
  </a>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="space-y-1">
      <h2 class="text-h4 font-semibold text-fg">
        <a href={href} class="hover:text-primary">{product.title}</a>
      </h2>
      {
        !compact && product.description && (
          <p class="line-clamp-2 text-small text-fg-muted">{product.description}</p>
        )
      }
    </div>
    <div class="mt-auto flex items-center justify-between gap-3">
      <p class="text-body font-bold text-primary" data-product-card-price>{price}</p>
      {
        product.availableForSale ? (
          <span
            data-stock-badge
            data-in-stock="true"
            class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary"
          >
            {availability.available}
          </span>
        ) : (
          <span
            data-stock-badge
            data-in-stock="false"
            class="rounded-full bg-black/10 px-2 py-0.5 text-xs font-medium text-fg-muted"
          >
            {availability.unavailable}
          </span>
        )
      }
    </div>
    <a
      href={href}
      class="inline-flex w-full items-center justify-center rounded-button border-2 border-accent px-5 py-2.5 text-center text-body font-medium text-fg-soft transition-colors hover:bg-accent/10 hover:text-fg"
    >
      {labels.viewProduct}
    </a>
  </div>
</article>
