<a
  href="/cart/"
  class="relative inline-flex h-9 w-9 items-center justify-center rounded-button text-fg-soft transition-colors hover:bg-black/5 hover:text-fg"
  aria-label="Cart"
  data-cart-link
>
  <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M3 3h2l.4 2M7 13h10l3-8H6.4M7 13l-1.2 6h12.4M7 13l-.6-3m4.6 9a1 1 0 1 1-2 0 1 1 0 0 1 2 0Zm8 0a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"
    ></path>
  </svg>
  <span
    data-cart-count
    class="absolute -right-1 -top-1 hidden min-w-4 rounded-full bg-primary px-1 text-center text-[10px] font-bold leading-4 text-white"
    >0</span
  >
</a>

<script>
  import { CART_UPDATED_EVENT, fetchCart } from '@/lib/shopify/cart-client';

  function setCount(quantity: number) {
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((badge) => {
      if (quantity > 0) {
        badge.textContent = quantity > 99 ? '99+' : String(quantity);
        badge.classList.remove('hidden');
      } else {
        badge.textContent = '0';
        badge.classList.add('hidden');
      }
    });
  }

  function onCartUpdated(event: Event) {
    const detail = (event as CustomEvent<{ quantity?: number }>).detail;
    setCount(detail?.quantity ?? 0);
  }

  async function hydrate() {
    try {
      const cart = await fetchCart();
      setCount(cart?.totalQuantity ?? 0);
    } catch {
      setCount(0);
    }
  }

  window.addEventListener(CART_UPDATED_EVENT, onCartUpdated);
  hydrate();
  document.addEventListener('astro:page-load', hydrate);
</script>
