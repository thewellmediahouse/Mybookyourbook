---
/**
 * Shopify CDN photos — not in the Astro asset pipeline.
 * Requests sized derivatives via `width` so mobile does not download desktop files.
 */
import { defaultSizes, defaultSrcWidths } from '@/utils/responsive-image';
import { shopifyImageSrcset, shopifyImageUrl } from '@/lib/shopify/image-url';

interface Props {
  url: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'auto' | 'sync';
  /** Forwarded for PDP gallery / variant swaps. */
  productImage?: boolean;
}

const {
  url,
  alt,
  width,
  height,
  class: className,
  loading = 'lazy',
  fetchpriority,
  decoding = 'async',
  productImage = false,
} = Astro.props;

const widths = Astro.props.widths ?? defaultSrcWidths(width);
const sizes = Astro.props.sizes ?? defaultSizes(width);
const src = shopifyImageUrl(url, widths[widths.length - 1] ?? width);
const srcset = shopifyImageSrcset(url, widths);
---

<img
  src={src}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  width={width}
  height={height}
  class={className}
  loading={loading}
  fetchpriority={fetchpriority}
  decoding={decoding}
  data-product-image={productImage ? '' : undefined}
  data-shopify-widths={widths.join(',')}
/>
