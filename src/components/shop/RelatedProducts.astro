---
import { shopConfig } from '@/config/shop';
import type { ProductSummary } from '@/lib/shopify';
import ProductGrid from './ProductGrid.astro';

interface Props {
  products: ProductSummary[];
  heading?: string;
  paragraph?: string;
}

const relatedCopy = shopConfig.product.related;
const {
  products,
  heading = relatedCopy.heading,
  paragraph = relatedCopy.paragraph,
} = Astro.props;
---

{
  products.length > 0 && (
    <section
      class="border-t border-[color:var(--color-border)] py-section"
      aria-labelledby="related-products-heading"
    >
      <div class="container space-y-8">
        <div class="max-w-2xl space-y-2">
          <h2 id="related-products-heading" class="text-h2 font-semibold text-fg">
            {heading}
          </h2>
          <p class="text-fg-muted">{paragraph}</p>
        </div>
        <ProductGrid products={products} compact />
      </div>
    </section>
  )
}
