---
/** Refreshes catalog + product stock from Shopify Storefront API in the browser. */
---

<script>
  import { shopConfig } from '@/config/shop';
  import { formatMoney } from '@/lib/shopify/format';
  import {
    fetchCatalogAvailability,
    fetchProductAvailability,
  } from '@/lib/shopify/availability-client';

  const availableLabel = shopConfig.availability.available;
  const unavailableLabel = shopConfig.availability.unavailable;
  const currentlyUnavailable = shopConfig.availability.currentlyUnavailable;
  const addLabel = shopConfig.labels.addToCart;
  const buyLabel = shopConfig.labels.buyNow;
  const soldOutLabel = shopConfig.labels.soldOut;

  function setBadge(badge: HTMLElement, inStock: boolean) {
    badge.dataset.inStock = inStock ? 'true' : 'false';
    badge.textContent = inStock ? availableLabel : unavailableLabel;
    badge.className = inStock
      ? 'rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary'
      : 'rounded-full bg-black/10 px-2 py-0.5 text-xs font-medium text-fg-muted';
  }

  async function syncCatalogStock() {
    const cards = document.querySelectorAll<HTMLElement>('[data-product-card][data-product-handle]');
    if (!cards.length) return;

    const availability = await fetchCatalogAvailability();
    if (!availability.length) return;

    const byHandle = new Map(availability.map((item) => [item.handle, item]));

    cards.forEach((card) => {
      const handle = card.dataset.productHandle;
      if (!handle) return;
      const live = byHandle.get(handle);
      if (!live) return;

      const badge = card.querySelector<HTMLElement>('[data-stock-badge]');
      if (badge) setBadge(badge, live.availableForSale);

      const priceEl = card.querySelector<HTMLElement>('[data-product-card-price]');
      if (priceEl && live.price) priceEl.textContent = formatMoney(live.price);
    });
  }

  async function syncProductPageStock() {
    const form = document.querySelector<HTMLElement>('[data-product-form][data-product-handle]');
    if (!form) return;

    const handle = form.dataset.productHandle;
    if (!handle) return;

    const live = await fetchProductAvailability(handle);
    if (!live) return;

    const payloadEl = form.querySelector('[data-variant-payload]');
    if (payloadEl?.textContent) {
      try {
        const payload = JSON.parse(payloadEl.textContent) as {
          variants: {
            id: string;
            availableForSale: boolean;
            price: { amount: string; currencyCode: string };
          }[];
        };

        const byId = new Map(live.variants.map((variant) => [variant.id, variant]));
        payload.variants = payload.variants.map((variant) => {
          const next = byId.get(variant.id);
          if (!next) return variant;
          return {
            ...variant,
            availableForSale: next.availableForSale,
            price: next.price,
          };
        });
        payloadEl.textContent = JSON.stringify(payload).replace(/</g, '\\u003c');
        form.dispatchEvent(new CustomEvent('shop:variants-updated'));
      } catch {
        // Keep build-time payload if refresh fails to parse.
      }
    }

    const availabilityEl = form.querySelector<HTMLElement>('[data-product-availability]');
    const addBtn = form.querySelector<HTMLButtonElement>('[data-add-to-cart]');
    const buyBtn = form.querySelector<HTMLButtonElement>('[data-buy-button]');
    const radios = form.querySelectorAll<HTMLInputElement>('[data-option-name]');

    if (radios.length === 0) {
      const variant = live.variants.find((item) => item.availableForSale) ?? live.variants[0];
      const available = Boolean(variant?.availableForSale ?? live.availableForSale);

      if (availabilityEl) {
        availabilityEl.textContent = available ? availableLabel : currentlyUnavailable;
        availabilityEl.classList.toggle('text-primary', available);
        availabilityEl.classList.toggle('text-fg-muted', !available);
      }

      const priceEl = form.querySelector<HTMLElement>('[data-product-price]');
      if (priceEl && variant?.price) priceEl.textContent = formatMoney(variant.price);

      [addBtn, buyBtn].forEach((button) => {
        if (!button) return;
        const label = button.hasAttribute('data-add-to-cart') ? addLabel : buyLabel;
        if (variant?.id) button.dataset.variantId = variant.id;
        button.disabled = !available;
        button.textContent = available ? label : soldOutLabel;
      });
    }
  }

  async function syncLiveStock() {
    await Promise.all([syncCatalogStock(), syncProductPageStock()]);
  }

  syncLiveStock();
  document.addEventListener('astro:page-load', syncLiveStock);

  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') syncLiveStock();
  });
</script>
