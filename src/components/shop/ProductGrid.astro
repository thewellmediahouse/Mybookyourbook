---
import { shopConfig } from '@/config/shop';
import type { ProductSummary } from '@/lib/shopify';
import ProductCard from './ProductCard.astro';

interface Props {
  products: ProductSummary[];
  compact?: boolean;
}

const { products, compact = false } = Astro.props;
const empty = shopConfig.emptyCatalog;
---

{
  products.length > 0 ? (
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((product) => (
        <ProductCard product={product} compact={compact} />
      ))}
    </div>
  ) : (
    <div class="surface-card p-8 text-center">
      <h2 class="text-h3 font-semibold text-fg">{empty.heading}</h2>
      <p class="mt-2 text-fg-muted">{empty.paragraph}</p>
    </div>
  )
}
